WARECOMMAND_POSTGRES_DB=warecommand
WARECOMMAND_POSTGRES_USER=warecommand
WARECOMMAND_POSTGRES_PASSWORD=replace-with-a-local-only-secret
WARECOMMAND_POSTGRES_BIND_ADDRESS=127.0.0.1
WARECOMMAND_POSTGRES_PORT=5432
WARECOMMAND_WEB_BIND_ADDRESS=127.0.0.1
WARECOMMAND_WEB_PORT=8080
WARECOMMAND_ALLOWED_HOSTS=*
WARECOMMAND_VERSION=0.0.0-local
WARECOMMAND_REVISION=local
WARECOMMAND_BUILD_DATE=unknown
WARECOMMAND_FORWARDED_HEADERS_ENABLED=false
WARECOMMAND_HTTPS_REDIRECTION_ENABLED=false
WARECOMMAND_AUTH_COOKIE_SECURE=false
WARECOMMAND_AUTH_BOOTSTRAP_ENABLED=false
WARECOMMAND_SHUTDOWN_TIMEOUT_SECONDS=30
WARECOMMAND_BACKUPS_ENABLED=false
WARECOMMAND_BACKUPS_OFFSITE_PATH=
WARECOMMAND_BACKUPS_RETENTION_DAYS=30
WARECOMMAND_BACKUPS_MINIMUM_RETAINED=2
WARECOMMAND_BACKUPS_MAXIMUM_AGE_HOURS=36
# Supply a 32-byte raw, 64-character hex, or 32-byte Base64 key outside this file.
WARECOMMAND_BACKUP_ENCRYPTION_KEY=replace-with-a-secret-backup-key
