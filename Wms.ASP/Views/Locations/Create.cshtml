@model CreateLocationViewModel
@{
    ViewData["Title"] = T["Locations.Create"];
    ViewData["LocationFormMode"] = "create";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>@T["Locations.Create"]</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@T["Common.Back"]</a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card border-0 shadow">
            <div class="card-header bg-primary bg-opacity-10 border-bottom">
                <h5 class="card-title mb-0 text-primary"><i class="bi bi-geo-alt me-2"></i>@T["Locations.Information"]</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <partial name="_LocationForm" model="Model" />
                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Cancel"]</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>@T["Common.Create"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
