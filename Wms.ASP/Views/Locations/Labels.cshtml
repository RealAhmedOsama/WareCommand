@model LocationLabelsViewModel
@{
    ViewData["Title"] = T["Locations.Labels"];
}

<div class="d-print-none d-flex justify-content-between align-items-center mb-4"><h2 class="mb-0"><i class="bi bi-upc-scan me-2 text-primary"></i>@T["Locations.Labels"]</h2><div class="d-flex gap-2"><button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-1"></i>@T["Common.Print"]</button><a asp-action="Index" asp-route-warehouseId="@Model.WarehouseId" class="btn btn-outline-secondary">@T["Common.Back"]</a></div></div>
<div class="row g-3">
    @foreach (var label in Model.Labels)
    {
        <div class="col-md-4 col-sm-6"><div class="card border-dark h-100"><div class="card-body text-center"><div class="small text-muted">@label.FullPath</div><div class="display-6 fw-bold font-monospace mt-2">@label.Code</div><div>@label.Name</div><div class="mt-3 font-monospace">@(label.Barcode ?? "—")</div><div class="small text-muted mt-2">@T[$"Locations.Type.{label.Type}"]</div></div></div></div>
    }
</div>
@if (Model.Labels.Count == 0)
{
    <div class="text-center text-muted py-5">@T["Locations.NoLabels"]</div>
}
