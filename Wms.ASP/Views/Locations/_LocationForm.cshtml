@model CreateLocationViewModel
@{
    var isEdit = string.Equals(ViewData["LocationFormMode"]?.ToString(), "edit", StringComparison.Ordinal);
}

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Code" class="form-label">@T["Locations.Code"] <span class="text-danger">*</span></label>
        <input asp-for="Code" class="form-control wms-identifier" readonly="@isEdit" required="required" />
        <span asp-validation-for="Code" class="text-danger"></span>
        <div class="form-text">@T["Locations.CodeHelp"]</div>
    </div>
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">@T["Locations.Name"] <span class="text-danger">*</span></label>
        <input asp-for="Name" class="form-control" required="required" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="WarehouseId" class="form-label">@T["Field.Warehouse"]</label>
        <select asp-for="WarehouseId" class="form-select" disabled="@isEdit">
            <option value="">@T["Locations.SelectWarehouse"]</option>
            @foreach (var warehouse in Model.Warehouses)
            {
                <option value="@warehouse.Id">@warehouse.Code — @warehouse.Name</option>
            }
        </select>
        <span asp-validation-for="WarehouseId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ParentLocationId" class="form-label">@T["Locations.Parent"]</label>
        <select asp-for="ParentLocationId" class="form-select">
            <option value="">@T["Locations.NoParent"]</option>
            @foreach (var parent in Model.ParentLocations)
            {
                <option value="@parent.Id">@parent.FullPath — @parent.Name</option>
            }
        </select>
        <span asp-validation-for="ParentLocationId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Type" class="form-label">@T["Locations.Type"]</label>
        <select asp-for="Type" class="form-select">
            @foreach (var type in Enum.GetValues<LocationType>())
            {
                <option value="@type">@T[$"Locations.Type.{type}"]</option>
            }
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Barcode" class="form-label">@T["Locations.Barcode"]</label>
        <input asp-for="Barcode" class="form-control wms-identifier" />
        <span asp-validation-for="Barcode" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Priority" class="form-label">@T["Locations.Priority"]</label>
        <input asp-for="Priority" class="form-control" type="number" min="0" />
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="StorageProfile" class="form-label">@T["Locations.StorageProfile"]</label>
        <input asp-for="StorageProfile" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="MaxUnits" class="form-label">@T["Locations.MaxUnits"]</label>
        <input asp-for="MaxUnits" class="form-control" type="number" min="0" step="0.0001" />
        <span asp-validation-for="MaxUnits" class="text-danger"></span>
        <div class="form-text">@T["Locations.CapacityHelp"]</div>
    </div>

    <div class="col-12"><hr class="my-2" /><h6 class="text-muted">@T["Locations.CapacityAndConstraints"]</h6></div>
    <div class="col-md-4">
        <label asp-for="MaxWeightKg" class="form-label">@T["Locations.MaxWeightKg"]</label>
        <input asp-for="MaxWeightKg" class="form-control" type="number" min="0" step="0.0001" />
    </div>
    <div class="col-md-4">
        <label asp-for="MaxVolumeCubicMeters" class="form-label">@T["Locations.MaxVolume"]</label>
        <input asp-for="MaxVolumeCubicMeters" class="form-control" type="number" min="0" step="0.0001" />
    </div>
    <div class="col-md-2">
        <label asp-for="MaxPallets" class="form-label">@T["Locations.MaxPallets"]</label>
        <input asp-for="MaxPallets" class="form-control" type="number" min="0" />
    </div>
    <div class="col-md-2">
        <label asp-for="MaxLpns" class="form-label">@T["Locations.MaxLpns"]</label>
        <input asp-for="MaxLpns" class="form-control" type="number" min="0" />
    </div>
    <div class="col-md-3">
        <label asp-for="MinimumTemperatureCelsius" class="form-label">@T["Locations.MinTemperature"]</label>
        <input asp-for="MinimumTemperatureCelsius" class="form-control" type="number" step="0.1" />
    </div>
    <div class="col-md-3">
        <label asp-for="MaximumTemperatureCelsius" class="form-label">@T["Locations.MaxTemperature"]</label>
        <input asp-for="MaximumTemperatureCelsius" class="form-control" type="number" step="0.1" />
    </div>
    <div class="col-md-3">
        <label asp-for="HazardClass" class="form-label">@T["Locations.HazardClass"]</label>
        <input asp-for="HazardClass" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="AccessRestriction" class="form-label">@T["Locations.AccessRestriction"]</label>
        <input asp-for="AccessRestriction" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="ConstraintAttributesJson" class="form-label">@T["Locations.ConstraintAttributes"]</label>
        <textarea asp-for="ConstraintAttributesJson" class="form-control" rows="2" placeholder="{}"></textarea>
        <span asp-validation-for="ConstraintAttributesJson" class="text-danger"></span>
    </div>

    <div class="col-12"><hr class="my-2" /><h6 class="text-muted">@T["Locations.Properties"]</h6></div>
    <div class="col-md-3"><div class="form-check form-switch"><input asp-for="IsPickable" class="form-check-input" /><label asp-for="IsPickable" class="form-check-label">@T["Locations.Pickable"]</label></div></div>
    <div class="col-md-3"><div class="form-check form-switch"><input asp-for="IsReceivable" class="form-check-input" /><label asp-for="IsReceivable" class="form-check-label">@T["Locations.Receivable"]</label></div></div>
    <div class="col-md-3"><div class="form-check form-switch"><input asp-for="IsCountable" class="form-check-input" /><label asp-for="IsCountable" class="form-check-label">@T["Locations.Countable"]</label></div></div>
    <div class="col-md-3"><div class="form-check form-switch"><input asp-for="AllowMixedItems" class="form-check-input" /><label asp-for="AllowMixedItems" class="form-check-label">@T["Locations.MixedItems"]</label></div></div>
    <div class="col-md-3"><div class="form-check form-switch"><input asp-for="AllowMixedLots" class="form-check-input" /><label asp-for="AllowMixedLots" class="form-check-label">@T["Locations.MixedLots"]</label></div></div>
</div>
