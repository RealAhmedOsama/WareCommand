@model LocationChildrenViewModel
@{
    ViewData["Title"] = T["Locations.Hierarchy"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-diagram-3 me-2 text-primary"></i>@T["Locations.Hierarchy"]</h2>
    <a asp-action="Index" asp-route-warehouseId="@Model.WarehouseId" class="btn btn-outline-secondary">@T["Common.Back"]</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><h5 class="mb-0">@T["Locations.Children"]</h5></div>
    <div class="card-body p-0">
        @if (Model.Locations.Count == 0)
        {
            <div class="text-center py-5 text-muted">@T["Locations.NoChildren"]</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>@T["Locations.Code"]</th><th>@T["Locations.Name"]</th><th>@T["Locations.Type"]</th><th>@T["Field.Status"]</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var location in Model.Locations)
                    {
                        <tr><td><a asp-action="Details" asp-route-id="@location.Id"><code>@location.Code</code></a></td><td>@location.Name</td><td>@T[$"Locations.Type.{location.Type}"]</td><td>@(location.IsActive ? T["Common.Active"] : T["Common.Inactive"])</td><td class="text-end"><a asp-action="Children" asp-route-warehouseId="@location.WarehouseId" asp-route-parentLocationId="@location.Id" class="btn btn-sm btn-outline-primary">@T["Locations.Open"]</a></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
