@model Wms.Application.Inbound.AdvanceShippingNoticeDto
@{
    ViewData["Title"] = T["AdvanceShippingNotices.Details"];
    var canManage = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.AdvanceShippingNoticesManage)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h2 class="mb-1"><i class="bi bi-truck me-2 text-primary"></i>@Model.DocumentNumber</h2><p class="text-muted mb-0">@Model.SupplierCode · @Model.WarehouseCode</p></div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Back"]</a>@if (canManage && Model.CanEdit){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>@T["Common.Edit"]</a>}</div></div>

<div class="row g-4">
    <div class="col-lg-4"><div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h5 class="mb-0">@T["AdvanceShippingNotices.Profile"]</h5></div><div class="card-body"><dl class="row mb-0"><dt class="col-6">@T["Field.Status"]</dt><dd class="col-6">@T[$"AdvanceShippingNotices.Status.{Model.Status}"]</dd><dt class="col-6">@T["AdvanceShippingNotices.Supplier"]</dt><dd class="col-6">@Model.SupplierCode</dd><dt class="col-6">@T["AdvanceShippingNotices.Warehouse"]</dt><dd class="col-6">@Model.WarehouseCode</dd><dt class="col-6">@T["AdvanceShippingNotices.ExpectedArrival"]</dt><dd class="col-6">@(Model.ExpectedArrivalFromUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? T["Common.NotSet"])</dd><dt class="col-6">@T["AdvanceShippingNotices.Carrier"]</dt><dd class="col-6">@(Model.CarrierName ?? T["Common.NotSet"])</dd><dt class="col-6">@T["AdvanceShippingNotices.Tracking"]</dt><dd class="col-6">@(Model.TrackingReference ?? T["Common.NotSet"])</dd><dt class="col-6">@T["AdvanceShippingNotices.ExternalReference"]</dt><dd class="col-6">@(Model.ExternalReference ?? T["Common.NotSet"])</dd><dt class="col-6">@T["AdvanceShippingNotices.Dock"]</dt><dd class="col-6">@(Model.DockLocationId?.ToString() ?? T["Common.NotSet"])</dd></dl></div></div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes)){<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h5 class="mb-0">@T["AdvanceShippingNotices.Notes"]</h5></div><div class="card-body">@Model.Notes</div></div>}
        <div class="card shadow-sm border-0"><div class="card-header bg-white"><h5 class="mb-0">@T["AdvanceShippingNotices.Actions"]</h5></div><div class="card-body d-flex flex-wrap gap-2">@if(canManage && Model.CanSubmit){<form asp-action="Submit" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary"><i class="bi bi-send me-1"></i>@T["AdvanceShippingNotices.Submit"]</button></form>}@if(canManage && Model.Status == AdvanceShippingNoticeStatus.Submitted){<form asp-action="MarkExpected" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-primary"><i class="bi bi-calendar-check me-1"></i>@T["AdvanceShippingNotices.MarkExpected"]</button></form>}@if(canManage && Model.CanArrive){<form asp-action="Arrive" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-success"><i class="bi bi-box-arrow-in-down me-1"></i>@T["AdvanceShippingNotices.Arrive"]</button></form>}@if(canManage && Model.Status is AdvanceShippingNoticeStatus.Receiving or AdvanceShippingNoticeStatus.Exception){<form asp-action="Complete" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-success"><i class="bi bi-check2-circle me-1"></i>@T["AdvanceShippingNotices.Complete"]</button></form>}@if(canManage && Model.CanCancel){<form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i>@T["AdvanceShippingNotices.Cancel"]</button></form>}</div></div>
        @if (canManage && Model.Status is AdvanceShippingNoticeStatus.Arrived or AdvanceShippingNoticeStatus.Receiving)
        {
            <form asp-action="MarkException" method="post" class="mb-4">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-outline-danger"><i class="bi bi-exclamation-triangle me-1"></i>@T["AdvanceShippingNotices.MarkException"]</button>
            </form>
        }
    </div>
    <div class="col-lg-8"><div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white d-flex justify-content-between"><h5 class="mb-0">@T["AdvanceShippingNotices.Lines"]</h5><span class="text-muted">@Model.Lines.Count</span></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>#</th><th>@T["Items.Sku"]</th><th class="text-end">@T["AdvanceShippingNotices.ExpectedQuantity"]</th><th class="text-end">@T["AdvanceShippingNotices.Received"]</th><th class="text-end">@T["AdvanceShippingNotices.Remaining"]</th><th>@T["AdvanceShippingNotices.PreAdvice"]</th></tr></thead><tbody>@foreach (var line in Model.Lines){<tr><td>@line.LineNumber</td><td><span class="fw-semibold">@line.ItemSku</span><br /><small class="text-muted">@line.ItemName</small></td><td class="text-end">@line.ExpectedQuantity.ToString("N4") @line.EnteredUnitOfMeasure<br /><small class="text-muted">@line.ExpectedBaseQuantity.ToString("N4") @line.BaseUnitOfMeasure</small></td><td class="text-end">@line.ReceivedQuantity.ToString("N4")<br /><small class="text-muted">@line.ReceivedBaseQuantity.ToString("N4") @line.BaseUnitOfMeasure</small></td><td class="text-end">@line.RemainingBaseQuantity.ToString("N4") @line.BaseUnitOfMeasure</td><td><small>@(line.PreAdvisedLotNumber ?? "") @(line.PreAdvisedSerialNumber ?? "") @(line.ExpectedLicensePlateNumber ?? "")</small></td></tr>}</tbody></table></div></div>
        <div class="card shadow-sm border-0"><div class="card-header bg-white"><h5 class="mb-0">@T["AdvanceShippingNotices.Discrepancies"]</h5></div>@if(Model.Discrepancies.Count == 0){<div class="card-body text-muted">@T["AdvanceShippingNotices.NoDiscrepancies"]</div>}else{<div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>@T["Field.Status"]</th><th>@T["AdvanceShippingNotices.DiscrepancyDetails"]</th><th>@T["AdvanceShippingNotices.RecordedAt"]</th></tr></thead><tbody>@foreach(var discrepancy in Model.Discrepancies){<tr><td>@discrepancy.Kind</td><td>@discrepancy.Details</td><td>@discrepancy.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table></div>}</div>
    </div>
</div>
