@model AdvanceShippingNoticeFormViewModel
@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="WarehouseId" class="form-label">@T["AdvanceShippingNotices.Warehouse"]</label><select asp-for="WarehouseId" class="form-select"><option value="">@T["Common.Select"]</option>@foreach(var warehouse in Model.Warehouses){<option value="@warehouse.Id">@warehouse.Code - @warehouse.Name</option>}</select><span asp-validation-for="WarehouseId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="SupplierId" class="form-label">@T["AdvanceShippingNotices.Supplier"]</label><select asp-for="SupplierId" class="form-select"><option value="">@T["Common.Select"]</option>@foreach(var supplier in Model.Suppliers){<option value="@supplier.Id">@supplier.Code - @supplier.Name @(supplier.IsActive ? "" : "(inactive)")</option>}</select><span asp-validation-for="SupplierId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ExpectedArrivalFromUtc" class="form-label">@T["AdvanceShippingNotices.ExpectedFrom"]</label><input asp-for="ExpectedArrivalFromUtc" type="datetime-local" class="form-control" /></div><div class="col-md-4"><label asp-for="ExpectedArrivalToUtc" class="form-label">@T["AdvanceShippingNotices.ExpectedTo"]</label><input asp-for="ExpectedArrivalToUtc" type="datetime-local" class="form-control" /></div><div class="col-md-4"><label asp-for="CarrierName" class="form-label">@T["AdvanceShippingNotices.Carrier"]</label><input asp-for="CarrierName" class="form-control" maxlength="200" /></div><div class="col-md-4"><label asp-for="VehicleNumber" class="form-label">@T["AdvanceShippingNotices.Vehicle"]</label><input asp-for="VehicleNumber" class="form-control" maxlength="100" /></div><div class="col-md-4"><label asp-for="TrailerNumber" class="form-label">@T["AdvanceShippingNotices.Trailer"]</label><input asp-for="TrailerNumber" class="form-control" maxlength="100" /></div><div class="col-md-4"><label asp-for="ContainerNumber" class="form-label">@T["AdvanceShippingNotices.Container"]</label><input asp-for="ContainerNumber" class="form-control" maxlength="100" /></div><div class="col-md-6"><label asp-for="TrackingReference" class="form-label">@T["AdvanceShippingNotices.Tracking"]</label><input asp-for="TrackingReference" class="form-control" maxlength="100" /></div><div class="col-md-6"><label asp-for="ExternalReference" class="form-label">@T["AdvanceShippingNotices.ExternalReference"]</label><input asp-for="ExternalReference" class="form-control" maxlength="100" /></div><div class="col-md-4"><label asp-for="SourceType" class="form-label">@T["AdvanceShippingNotices.Source"]</label><input asp-for="SourceType" class="form-control" maxlength="30" /></div><div class="col-md-4"><label asp-for="SourceReference" class="form-label">@T["AdvanceShippingNotices.SourceReference"]</label><input asp-for="SourceReference" class="form-control" maxlength="200" /></div><div class="col-md-4"><label asp-for="DockLocationId" class="form-label">@T["AdvanceShippingNotices.DockId"]</label><input asp-for="DockLocationId" class="form-control" type="number" min="1" /></div><div class="col-12"><label asp-for="SourcePayload" class="form-label">@T["AdvanceShippingNotices.SourcePayload"]</label><textarea asp-for="SourcePayload" class="form-control font-monospace" rows="3"></textarea></div><div class="col-12"><label asp-for="Notes" class="form-label">@T["AdvanceShippingNotices.Notes"]</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div><div class="col-12"><div class="form-check"><input asp-for="AllowMultiplePurchaseOrders" class="form-check-input" /><label asp-for="AllowMultiplePurchaseOrders" class="form-check-label">@T["AdvanceShippingNotices.AllowMultiplePurchaseOrders"]</label></div></div></div></div></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h5 class="mb-1">@T["AdvanceShippingNotices.Lines"]</h5><small class="text-muted">@T["AdvanceShippingNotices.LinesHelp"]</small></div><div class="card-body"><label asp-for="LinesText" class="form-label">@T["AdvanceShippingNotices.LineRows"]</label><textarea asp-for="LinesText" class="form-control font-monospace" rows="10" placeholder="SKU|10|EA|CASE|PO_ID|PO_LINE_ID|5|2|LOT|2026-12-31|SERIAL|LPN|false|Notes"></textarea><span asp-validation-for="LinesText" class="text-danger"></span></div></div>
<div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Cancel"]</a><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@T["Common.Save"]</button></div>
