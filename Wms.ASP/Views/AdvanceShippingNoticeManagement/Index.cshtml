@model AdvanceShippingNoticeListViewModel
@{
    ViewData["Title"] = T["AdvanceShippingNotices.Title"];
    var canManage = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.AdvanceShippingNoticesManage)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><h2 class="mb-1"><i class="bi bi-truck me-2 text-primary"></i>@T["AdvanceShippingNotices.Title"]</h2><p class="text-muted mb-0">@T["AdvanceShippingNotices.Subtitle"]</p></div>
    <div class="d-flex gap-2">
        @if (canManage) { <a asp-action="Import" class="btn btn-outline-primary"><i class="bi bi-upload me-1"></i>@T["AdvanceShippingNotices.Import"]</a> }
        <a asp-action="Export" asp-route-searchTerm="@Model.SearchTerm" asp-route-warehouseId="@Model.WarehouseId" asp-route-supplierId="@Model.SupplierId" asp-route-status="@Model.Status" class="btn btn-outline-secondary"><i class="bi bi-download me-1"></i>@T["AdvanceShippingNotices.Export"]</a>
        @if (canManage) { <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>@T["AdvanceShippingNotices.Add"]</a> }
    </div>
</div>

<div class="card shadow-sm border-0 mb-4"><div class="card-body"><form asp-action="Index" method="get" class="row g-3 align-items-end">
    <div class="col-md-4"><label for="searchTerm" class="form-label">@T["AdvanceShippingNotices.Search"]</label><input id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="@T["AdvanceShippingNotices.SearchPlaceholder"]" /></div>
    <div class="col-md-3"><label for="warehouseId" class="form-label">@T["AdvanceShippingNotices.Warehouse"]</label><select id="warehouseId" name="warehouseId" class="form-select"><option value="">@T["Common.All"]</option>@foreach (var warehouse in Model.Warehouses){<option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">@warehouse.Code - @warehouse.Name</option>}</select></div>
    <div class="col-md-2"><label for="supplierId" class="form-label">@T["AdvanceShippingNotices.SupplierId"]</label><input id="supplierId" name="supplierId" value="@Model.SupplierId" class="form-control" type="number" min="1" /></div>
    <div class="col-md-2"><label for="status" class="form-label">@T["Field.Status"]</label><select id="status" name="status" class="form-select"><option value="">@T["Common.All"]</option>@foreach (var status in Enum.GetValues<AdvanceShippingNoticeStatus>()){<option value="@status" selected="@(Model.Status == status)">@T[$"AdvanceShippingNotices.Status.{status}"]</option>}</select></div>
    <div class="col-md-1 d-grid"><button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button></div>
    <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="includeCancelled" name="includeCancelled" value="true" checked="@Model.IncludeCancelled" /><label class="form-check-label" for="includeCancelled">@T["AdvanceShippingNotices.IncludeCancelled"]</label><input type="hidden" name="includeCancelled" value="false" /></div></div>
</form></div></div>

<div class="card shadow-sm border-0"><div class="card-header bg-white d-flex justify-content-between align-items-center"><h5 class="mb-0"><i class="bi bi-list-ul me-2 text-primary"></i>@T["AdvanceShippingNotices.List"]</h5><span class="text-muted">@Model.TotalCount @T["AdvanceShippingNotices.Total"]</span></div>
    @if (Model.AdvanceShippingNotices.Count == 0)
    { <div class="card-body text-center text-muted py-5"><i class="bi bi-truck fs-1 d-block mb-3"></i><p class="mb-0">@T["AdvanceShippingNotices.None"]</p></div> }
    else
    { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>@T["AdvanceShippingNotices.Number"]</th><th>@T["AdvanceShippingNotices.Supplier"]</th><th>@T["AdvanceShippingNotices.Warehouse"]</th><th>@T["AdvanceShippingNotices.ExpectedArrival"]</th><th>@T["AdvanceShippingNotices.Lines"]</th><th>@T["Field.Status"]</th><th>@T["Common.Actions"]</th></tr></thead><tbody>
        @foreach (var notice in Model.AdvanceShippingNotices)
        { <tr><td class="fw-semibold"><a asp-action="Details" asp-route-id="@notice.Id">@notice.DocumentNumber</a><br /><small class="text-muted">@notice.ExternalReference</small></td><td>@notice.SupplierCode<br /><small class="text-muted">@notice.SupplierName</small></td><td>@notice.WarehouseCode</td><td>@(notice.ExpectedArrivalFromUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? T["Common.NotSet"].Value)</td><td>@notice.Lines.Count</td><td><span class="badge @(notice.Status switch { AdvanceShippingNoticeStatus.Arrived or AdvanceShippingNoticeStatus.Receiving => "bg-primary", AdvanceShippingNoticeStatus.Completed => "bg-success", AdvanceShippingNoticeStatus.Cancelled => "bg-secondary", AdvanceShippingNoticeStatus.Exception => "bg-danger", _ => "bg-warning text-dark" })">@T[$"AdvanceShippingNotices.Status.{notice.Status}"]</span></td><td><div class="btn-group btn-group-sm"><a asp-action="Details" asp-route-id="@notice.Id" class="btn btn-outline-secondary"><i class="bi bi-eye"></i></a>@if (canManage && notice.CanEdit){<a asp-action="Edit" asp-route-id="@notice.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i></a>}</div></td></tr> }
    </tbody></table></div>
        @if (Model.TotalPages > 1) { <div class="card-footer bg-white d-flex justify-content-between align-items-center"><span class="text-muted">@T["AdvanceShippingNotices.PageOf", Model.Page, Model.TotalPages]</span><div class="btn-group">@if (Model.Page > 1){<a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm" asp-route-warehouseId="@Model.WarehouseId" asp-route-supplierId="@Model.SupplierId" asp-route-status="@Model.Status" class="btn btn-outline-secondary">@T["Common.Previous"]</a>}@if (Model.Page < Model.TotalPages){<a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm" asp-route-warehouseId="@Model.WarehouseId" asp-route-supplierId="@Model.SupplierId" asp-route-status="@Model.Status" class="btn btn-outline-secondary">@T["Common.Next"]</a>}</div></div> }
    }
</div>
