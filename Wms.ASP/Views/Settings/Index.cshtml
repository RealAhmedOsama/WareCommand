@model SettingsIndexViewModel
@{
    ViewData["Title"] = T["Settings.Title"];
    var isGlobal = !Model.WarehouseId.HasValue;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-sliders me-2 text-primary"></i>@T["Settings.Title"]</h2>
        <p class="text-muted mb-0">@Model.ScopeName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Export" class="btn btn-outline-primary">@T["Settings.Export"]</a>
    </div>
</div>

<div class="alert alert-info border-0 shadow-sm">
    <strong>@T["Settings.ConfigurationBoundary"]:</strong> @T["Settings.ConfigurationBoundaryText"]
    @T["Settings.ReloadText"]
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label for="warehouseId" class="form-label">@T["Settings.Scope"]</label>
                <select id="warehouseId" name="warehouseId" class="form-select">
                    <option value="">@T["Settings.GlobalDefaults"]</option>
                    @foreach (var warehouse in Model.Warehouses)
                    {
                        <option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">
                            @warehouse.Code - @warehouse.Name
                        </option>
                    }
                </select>
                <div class="form-text">@T["Settings.ScopeHelp"]</div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-outline-secondary">@T["Settings.LoadScope"]</button>
            </div>
        </form>
    </div>
</div>

@if (isGlobal)
{
    <form asp-action="SaveGlobal" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Settings.CompanyWarehouseDefaults"]</h5></div>
            <div class="card-body row g-3">
                <div class="col-md-6"><label asp-for="Global.CompanyName" class="form-label">@T["Settings.CompanyName"]</label><input asp-for="Global.CompanyName" class="form-control" /><span asp-validation-for="Global.CompanyName" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Global.CompanyCode" class="form-label">@T["Settings.CompanyCode"]</label><input asp-for="Global.CompanyCode" class="form-control wms-identifier" /><span asp-validation-for="Global.CompanyCode" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.DefaultWarehouseId" class="form-label">@T["Settings.DefaultWarehouse"]</label><select asp-for="Global.DefaultWarehouseId" class="form-select"><option value="">@T["Settings.NotConfigured"]</option>@foreach (var warehouse in Model.Warehouses){<option value="@warehouse.Id">@warehouse.Code - @warehouse.Name</option>}</select><span asp-validation-for="Global.DefaultWarehouseId" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.DefaultReceivingLocationCode" class="form-label">@T["Settings.ReceivingLocationCode"]</label><input asp-for="Global.DefaultReceivingLocationCode" class="form-control wms-identifier" /><span asp-validation-for="Global.DefaultReceivingLocationCode" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.DefaultShippingLocationCode" class="form-label">@T["Settings.ShippingLocationCode"]</label><input asp-for="Global.DefaultShippingLocationCode" class="form-control wms-identifier" /><span asp-validation-for="Global.DefaultShippingLocationCode" class="text-danger"></span></div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Settings.NumberingDashboard"]</h5></div>
            <div class="card-body row g-3">
                <div class="col-md-4"><label asp-for="Global.ReceivingPrefix" class="form-label">@T["Settings.ReceivingPrefix"]</label><input asp-for="Global.ReceivingPrefix" class="form-control wms-identifier" /><span asp-validation-for="Global.ReceivingPrefix" class="text-danger"></span></div>
                <div class="col-md-2"><label asp-for="Global.NextReceivingNumber" class="form-label">@T["Settings.NextReceivingNumber"]</label><input asp-for="Global.NextReceivingNumber" class="form-control wms-number" /><span asp-validation-for="Global.NextReceivingNumber" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.ShippingPrefix" class="form-label">@T["Settings.ShippingPrefix"]</label><input asp-for="Global.ShippingPrefix" class="form-control wms-identifier" /><span asp-validation-for="Global.ShippingPrefix" class="text-danger"></span></div>
                <div class="col-md-2"><label asp-for="Global.NextShippingNumber" class="form-label">@T["Settings.NextShippingNumber"]</label><input asp-for="Global.NextShippingNumber" class="form-control wms-number" /><span asp-validation-for="Global.NextShippingNumber" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.AdjustmentPrefix" class="form-label">@T["Settings.AdjustmentPrefix"]</label><input asp-for="Global.AdjustmentPrefix" class="form-control wms-identifier" /><span asp-validation-for="Global.AdjustmentPrefix" class="text-danger"></span></div>
                <div class="col-md-2"><label asp-for="Global.NextAdjustmentNumber" class="form-label">@T["Settings.NextAdjustmentNumber"]</label><input asp-for="Global.NextAdjustmentNumber" class="form-control wms-number" /><span asp-validation-for="Global.NextAdjustmentNumber" class="text-danger"></span></div>
                <div class="col-md-3"><label asp-for="Global.LowStockThreshold" class="form-label">@T["Settings.LowStockThreshold"]</label><input asp-for="Global.LowStockThreshold" class="form-control" /><span asp-validation-for="Global.LowStockThreshold" class="text-danger"></span></div>
                <div class="col-md-3"><label asp-for="Global.LowStockAlertLimit" class="form-label">@T["Settings.LowStockAlertLimit"]</label><input asp-for="Global.LowStockAlertLimit" class="form-control" /><span asp-validation-for="Global.LowStockAlertLimit" class="text-danger"></span></div>
                <div class="col-md-3"><label asp-for="Global.RecentMovementLimit" class="form-label">@T["Settings.RecentMovementLimit"]</label><input asp-for="Global.RecentMovementLimit" class="form-control" /><span asp-validation-for="Global.RecentMovementLimit" class="text-danger"></span></div>
                <div class="col-md-3"><label asp-for="Global.RefreshIntervalSeconds" class="form-label">@T["Settings.RefreshIntervalSeconds"]</label><input asp-for="Global.RefreshIntervalSeconds" class="form-control" /><span asp-validation-for="Global.RefreshIntervalSeconds" class="text-danger"></span></div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Settings.InventoryScanner"]</h5></div>
            <div class="card-body row g-3">
                <div class="col-md-4"><label asp-for="Global.MaximumAdjustmentQuantity" class="form-label">@T["Settings.MaximumAdjustmentQuantity"]</label><input asp-for="Global.MaximumAdjustmentQuantity" class="form-control" /><span asp-validation-for="Global.MaximumAdjustmentQuantity" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.ExpiryWarningDays" class="form-label">@T["Settings.ExpiryWarningDays"]</label><input asp-for="Global.ExpiryWarningDays" class="form-control" /><span asp-validation-for="Global.ExpiryWarningDays" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.ScannerTimeoutMilliseconds" class="form-label">@T["Settings.ScannerTimeoutMilliseconds"]</label><input asp-for="Global.ScannerTimeoutMilliseconds" class="form-control" /><span asp-validation-for="Global.ScannerTimeoutMilliseconds" class="text-danger"></span></div>
                <div class="col-md-3"><label asp-for="Global.MinimumBarcodeLength" class="form-label">@T["Settings.MinimumBarcodeLength"]</label><input asp-for="Global.MinimumBarcodeLength" class="form-control" /><span asp-validation-for="Global.MinimumBarcodeLength" class="text-danger"></span></div>
                <div class="col-md-3"><label asp-for="Global.MaximumBarcodeLength" class="form-label">@T["Settings.MaximumBarcodeLength"]</label><input asp-for="Global.MaximumBarcodeLength" class="form-control" /><span asp-validation-for="Global.MaximumBarcodeLength" class="text-danger"></span></div>
                <div class="col-md-3 form-check ms-3 mt-4"><input asp-for="Global.AllowNegativeStock" class="form-check-input" /><label asp-for="Global.AllowNegativeStock" class="form-check-label">@T["Settings.AllowNegativeStock"]</label></div>
                <div class="col-md-3 form-check ms-3 mt-4"><input asp-for="Global.RequireLocationForAdjustment" class="form-check-input" /><label asp-for="Global.RequireLocationForAdjustment" class="form-check-label">@T["Settings.RequireLocationForAdjustment"]</label></div>
                <div class="col-md-3 form-check ms-3"><input asp-for="Global.BlockExpiredReceipt" class="form-check-input" /><label asp-for="Global.BlockExpiredReceipt" class="form-check-label">@T["Settings.BlockExpiredReceipt"]</label></div>
                <div class="col-md-3 form-check ms-3"><input asp-for="Global.EnableAudioFeedback" class="form-check-input" /><label asp-for="Global.EnableAudioFeedback" class="form-check-label">@T["Settings.EnableAudioFeedback"]</label></div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Settings.LabelsReportsLocalization"]</h5></div>
            <div class="card-body row g-3">
                <div class="col-md-4"><label asp-for="Global.LabelTemplateName" class="form-label">@T["Settings.LabelTemplateName"]</label><input asp-for="Global.LabelTemplateName" class="form-control" /><span asp-validation-for="Global.LabelTemplateName" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.LabelPaperSize" class="form-label">@T["Settings.LabelPaperSize"]</label><input asp-for="Global.LabelPaperSize" class="form-control" /><span asp-validation-for="Global.LabelPaperSize" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.DefaultReportPeriodDays" class="form-label">@T["Settings.DefaultReportPeriodDays"]</label><input asp-for="Global.DefaultReportPeriodDays" class="form-control" /><span asp-validation-for="Global.DefaultReportPeriodDays" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.MaximumReportRows" class="form-label">@T["Settings.MaximumReportRows"]</label><input asp-for="Global.MaximumReportRows" class="form-control" /><span asp-validation-for="Global.MaximumReportRows" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.Locale" class="form-label">@T["Settings.Locale"]</label><select asp-for="Global.Locale" class="form-select"><option value="@WmsLocaleCatalog.English">@T["Language.English"]</option><option value="@WmsLocaleCatalog.Arabic">@T["Language.Arabic"]</option></select><span asp-validation-for="Global.Locale" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.TimeZone" class="form-label">@T["Settings.TimeZone"]</label><input asp-for="Global.TimeZone" class="form-control" /><span asp-validation-for="Global.TimeZone" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.CurrencyCode" class="form-label">@T["Settings.Currency"]</label><input asp-for="Global.CurrencyCode" class="form-control wms-identifier" /><span asp-validation-for="Global.CurrencyCode" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.IntegrationEndpointUrl" class="form-label">@T["Settings.IntegrationEndpointUrl"]</label><input asp-for="Global.IntegrationEndpointUrl" class="form-control wms-identifier" /><span asp-validation-for="Global.IntegrationEndpointUrl" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Global.IntegrationTimeoutSeconds" class="form-label">@T["Settings.IntegrationTimeoutSeconds"]</label><input asp-for="Global.IntegrationTimeoutSeconds" class="form-control" /><span asp-validation-for="Global.IntegrationTimeoutSeconds" class="text-danger"></span></div>
                <div class="col-12 form-check"><input asp-for="Global.IncludeCompanyNameOnLabels" class="form-check-input" /><label asp-for="Global.IncludeCompanyNameOnLabels" class="form-check-label">@T["Settings.IncludeCompanyNameOnLabels"]</label></div>
                <div class="col-12 form-check"><input asp-for="Global.IntegrationsEnabled" class="form-check-input" /><label asp-for="Global.IntegrationsEnabled" class="form-check-label">@T["Settings.IntegrationsEnabled"]</label></div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">@T["Settings.SaveGlobal"]</button>
    </form>
}
else
{
    <form asp-action="SaveOverride" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Override.WarehouseId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Settings.WarehouseOverrides"]</h5></div>
            <div class="card-body row g-3">
                <div class="col-md-6"><label asp-for="Override.DefaultReceivingLocationCode" class="form-label">@T["Settings.ReceivingLocationCode"] (@T["Settings.BlankInherits"])</label><input asp-for="Override.DefaultReceivingLocationCode" class="form-control wms-identifier" /><span asp-validation-for="Override.DefaultReceivingLocationCode" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Override.DefaultShippingLocationCode" class="form-label">@T["Settings.ShippingLocationCode"] (@T["Settings.BlankInherits"])</label><input asp-for="Override.DefaultShippingLocationCode" class="form-control wms-identifier" /><span asp-validation-for="Override.DefaultShippingLocationCode" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.LowStockThreshold" class="form-label">@T["Settings.LowStockThreshold"]</label><input asp-for="Override.LowStockThreshold" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.LowStockThreshold" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.LowStockAlertLimit" class="form-label">@T["Settings.LowStockAlertLimit"]</label><input asp-for="Override.LowStockAlertLimit" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.LowStockAlertLimit" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.RecentMovementLimit" class="form-label">@T["Settings.RecentMovementLimit"]</label><input asp-for="Override.RecentMovementLimit" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.RecentMovementLimit" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.RefreshIntervalSeconds" class="form-label">@T["Settings.RefreshIntervalSeconds"]</label><input asp-for="Override.RefreshIntervalSeconds" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.RefreshIntervalSeconds" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.ExpiryWarningDays" class="form-label">@T["Settings.ExpiryWarningDays"]</label><input asp-for="Override.ExpiryWarningDays" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.ExpiryWarningDays" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.ScannerTimeoutMilliseconds" class="form-label">@T["Settings.ScannerTimeoutMilliseconds"]</label><input asp-for="Override.ScannerTimeoutMilliseconds" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.ScannerTimeoutMilliseconds" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.MinimumBarcodeLength" class="form-label">@T["Settings.MinimumBarcodeLength"]</label><input asp-for="Override.MinimumBarcodeLength" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.MinimumBarcodeLength" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.MaximumBarcodeLength" class="form-label">@T["Settings.MaximumBarcodeLength"]</label><input asp-for="Override.MaximumBarcodeLength" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.MaximumBarcodeLength" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.DefaultReportPeriodDays" class="form-label">@T["Settings.ReportPeriod"]</label><input asp-for="Override.DefaultReportPeriodDays" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.DefaultReportPeriodDays" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.MaximumReportRows" class="form-label">@T["Settings.ReportRows"]</label><input asp-for="Override.MaximumReportRows" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.MaximumReportRows" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.Locale" class="form-label">@T["Settings.Locale"]</label><select asp-for="Override.Locale" class="form-select"><option value="">@T["Settings.Inherit"]</option><option value="@WmsLocaleCatalog.English">@T["Language.English"]</option><option value="@WmsLocaleCatalog.Arabic">@T["Language.Arabic"]</option></select><span asp-validation-for="Override.Locale" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.TimeZone" class="form-label">@T["Settings.TimeZone"]</label><input asp-for="Override.TimeZone" class="form-control" placeholder="@T["Settings.Inherit"]" /><span asp-validation-for="Override.TimeZone" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="Override.BlockExpiredReceipt" class="form-label">@T["Settings.ExpiredReceiptBehavior"]</label><select asp-for="Override.BlockExpiredReceipt" class="form-select"><option value="">@T["Settings.Inherit"]</option><option value="true">@T["Settings.BlockExpiredReceipt"]</option><option value="false">@T["Settings.AllowExpiredReceipt"]</option></select></div>
                <div class="col-md-4"><label asp-for="Override.EnableAudioFeedback" class="form-label">@T["Settings.ScannerAudio"]</label><select asp-for="Override.EnableAudioFeedback" class="form-select"><option value="">@T["Settings.Inherit"]</option><option value="true">@T["Settings.Enabled"]</option><option value="false">@T["Settings.Disabled"]</option></select></div>
            </div>
        </div>
        <button type="submit" class="btn btn-primary">@T["Settings.SaveOverride"]</button>
    </form>
}

<div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white"><h5 class="mb-0">@T["Settings.Import"]</h5></div>
    <div class="card-body">
        <form asp-action="Import" method="post">
            @Html.AntiForgeryToken()
            <label for="ImportJson" class="form-label">@T["Settings.ImportLabel"]</label>
            <textarea id="ImportJson" name="ImportJson" class="form-control font-monospace" rows="8" maxlength="500000" placeholder="@T["Settings.ImportPlaceholder"]"></textarea>
            <div class="form-text">@T["Settings.ImportHelp"]</div>
            <button type="submit" class="btn btn-outline-danger mt-3">@T["Settings.ValidateImport"]</button>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white"><h5 class="mb-0">@T["Settings.Effective"]</h5></div>
    <div class="card-body row g-3">
        <div class="col-md-3"><strong>@T["Settings.LowStockThreshold"]</strong><div>@Model.EffectiveValues.Dashboard.LowStockThreshold</div></div>
        <div class="col-md-3"><strong>@T["Settings.RefreshInterval"]</strong><div>@Model.EffectiveValues.Dashboard.RefreshIntervalSeconds @T["Settings.Seconds"]</div></div>
        <div class="col-md-3"><strong>@T["Settings.ReceivingLocation"]</strong><div><code class="wms-identifier">@Model.EffectiveValues.WarehouseDefaults.DefaultReceivingLocationCode</code></div></div>
        <div class="col-md-3"><strong>@T["Settings.ExpiryWarning"]</strong><div>@Model.EffectiveValues.Expiry.WarningDays @T["Settings.Days"]</div></div>
    </div>
</div>
