@model Wms.Application.Receiving.ReceiptDto
@using Wms.Domain.Enums
@{
    ViewData["Title"] = T["Receipts.Details"];
    var canManage = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.ReceiptsManage)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h2 class="mb-1"><i class="bi bi-box-seam me-2 text-warning"></i>@Model.DocumentNumber</h2><p class="text-muted mb-0">@Model.WarehouseCode · @Model.SourceType</p></div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Back"]</a><a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-printer me-1"></i>@T["Receipts.Print"]</a></div></div>

<div class="row g-4">
    <div class="col-lg-4"><div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h5 class="mb-0">@T["Receipts.Details"]</h5></div><div class="card-body"><dl class="row mb-0"><dt class="col-6">@T["Receipts.Status"]</dt><dd class="col-6">@Model.Status</dd><dt class="col-6">@T["Receipts.Warehouse"]</dt><dd class="col-6">@Model.WarehouseCode</dd><dt class="col-6">@T["Receipts.Supplier"]</dt><dd class="col-6">@(Model.SupplierCode ?? T["Common.NotSet"])</dd><dt class="col-6">@T["Receipts.Source"]</dt><dd class="col-6">@Model.SourceType / @(Model.SourceReference ?? T["Common.NotSet"])</dd><dt class="col-6">@T["Receipts.CreatedAt"]</dt><dd class="col-6">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd><dt class="col-6">@T["Receipts.Received"]</dt><dd class="col-6">@(Model.ReceivedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? T["Common.NotSet"])</dd></dl></div></div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes)){<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h5 class="mb-0">@T["Receipts.Notes"]</h5></div><div class="card-body">@Model.Notes</div></div>}
        @if (canManage){<div class="card shadow-sm border-0"><div class="card-header bg-white"><h5 class="mb-0">@T["Receipts.Lifecycle"]</h5></div><div class="card-body d-flex flex-wrap gap-2">@if(Model.CanComplete){<form asp-action="Complete" method="post"><input type="hidden" name="id" value="@Model.Id" />@Html.AntiForgeryToken()<button class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>@T["Receipts.Complete"]</button></form>}@if(Model.CanCancel){<form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@Model.Id" />@Html.AntiForgeryToken()<button class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i>@T["Receipts.Cancel"]</button></form>}@if(Model.CanReverse){<form asp-action="Reverse" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@Model.Id" /><input name="reason" class="form-control" required placeholder="@T["Receipts.Reason"]" />@Html.AntiForgeryToken()<button class="btn btn-outline-danger"><i class="bi bi-arrow-counterclockwise me-1"></i>@T["Receipts.Reverse"]</button></form>}@if(Model.CanCorrect){<form asp-action="Correct" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@Model.Id" /><input name="reason" class="form-control" placeholder="@T["Receipts.Reason"]" /><input name="notes" class="form-control" placeholder="@T["Receipts.Notes"]" />@Html.AntiForgeryToken()<button class="btn btn-outline-warning"><i class="bi bi-pencil-square me-1"></i>@T["Receipts.Correct"]</button></form>}</div></div>}
    </div>
    <div class="col-lg-8"><div class="card shadow-sm border-0"><div class="card-header bg-white d-flex justify-content-between"><h5 class="mb-0">@T["Receipts.Lines"]</h5><span class="text-muted">@Model.Lines.Count</span></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>#</th><th>@T["Items.Sku"]</th><th class="text-end">@T["PurchaseOrders.ExpectedReceipt"]</th><th class="text-end">@T["Receipts.Received"]</th><th class="text-end">@T["Receipts.Accepted"]</th><th class="text-end">@T["Receipts.Remaining"]</th><th>@T["Field.Status"]</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.LineNumber</td><td><span class="fw-semibold">@line.ItemSku</span><br /><small class="text-muted">@line.ItemName</small></td><td class="text-end">@line.ExpectedBaseQuantity.ToString("N4") @line.BaseUnitOfMeasure</td><td class="text-end">@line.ReceivedBaseQuantity.ToString("N4")</td><td class="text-end">@line.AcceptedBaseQuantity.ToString("N4")</td><td class="text-end">@line.RemainingBaseQuantity.ToString("N4")</td><td>@(line.IsFullyReceived ? T["Receipts.Completed"] : T["Receipts.Open"])</td></tr>}</tbody></table></div></div></div>
</div>
