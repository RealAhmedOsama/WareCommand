@model Wms.ASP.Models.ReceiptListViewModel
@using Wms.Domain.Enums
@{
    ViewData["Title"] = T["Receipts.Title"];
    var canManage = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.ReceiptsManage)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><h2 class="mb-1"><i class="bi bi-box-seam me-2 text-warning"></i>@T["Receipts.Title"]</h2></div>
    <div class="d-flex gap-2">
        <a asp-controller="Receipts" asp-action="Export" class="btn btn-outline-secondary"><i class="bi bi-download me-1"></i>@T["PurchaseOrders.Export"]</a>
        @if (canManage) { <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>@T["Receipts.Create"]</a> }
    </div>
</div>

<div class="card shadow-sm border-0 mb-4"><div class="card-body"><form asp-action="Index" method="get" class="row g-3 align-items-end">
    <div class="col-md-4"><label for="searchTerm" class="form-label">@T["Receipts.Search"]</label><input id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" /></div>
    <div class="col-md-3"><label for="warehouseId" class="form-label">@T["Receipts.Warehouse"]</label><select id="warehouseId" name="warehouseId" class="form-select"><option value="">@T["Common.All"]</option>@foreach (var warehouse in Model.Warehouses){<option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">@warehouse.Code - @warehouse.Name</option>}</select></div>
    <div class="col-md-2"><label for="supplierId" class="form-label">@T["Receipts.Supplier"]</label><input id="supplierId" name="supplierId" value="@Model.SupplierId" class="form-control" type="number" min="1" /></div>
    <div class="col-md-2"><label for="status" class="form-label">@T["Receipts.Status"]</label><select id="status" name="status" class="form-select"><option value="">@T["Common.All"]</option>@foreach (var status in Enum.GetValues<ReceiptStatus>()){<option value="@status" selected="@(Model.Status == status)">@status</option>}</select></div>
    <div class="col-md-1 d-grid"><button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button></div>
    <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="includeCancelled" name="includeCancelled" value="true" checked="@Model.IncludeCancelled" /><label class="form-check-label" for="includeCancelled">@T["PurchaseOrders.IncludeCancelled"]</label><input type="hidden" name="includeCancelled" value="false" /></div></div>
</form></div></div>

<div class="card shadow-sm border-0"><div class="card-header bg-white d-flex justify-content-between align-items-center"><h5 class="mb-0"><i class="bi bi-list-ul me-2 text-primary"></i>@T["Receipts.Title"]</h5><span class="text-muted">@Model.TotalCount</span></div>
    @if (Model.Receipts.Count == 0)
    { <div class="card-body text-center text-muted py-5"><i class="bi bi-box-seam fs-1 d-block mb-3"></i><p class="mb-0">@T["Receipts.NoRows"]</p></div> }
    else
    { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>@T["PurchaseOrders.Number"]</th><th>@T["Receipts.Warehouse"]</th><th>@T["Receipts.Supplier"]</th><th>@T["Receipts.Source"]</th><th>@T["Receipts.Received"]</th><th>@T["Receipts.Status"]</th><th>@T["Common.Actions"]</th></tr></thead><tbody>
        @foreach (var receipt in Model.Receipts)
        { <tr><td class="fw-semibold"><a asp-action="Details" asp-route-id="@receipt.Id">@receipt.DocumentNumber</a><br /><small class="text-muted">@receipt.ExternalReference</small></td><td>@receipt.WarehouseCode</td><td>@receipt.SupplierCode<br /><small class="text-muted">@receipt.SupplierName</small></td><td>@receipt.SourceType<br /><small class="text-muted">@receipt.SourceReference</small></td><td>@(receipt.ReceivedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? T["Common.NotSet"])</td><td><span class="badge @(receipt.Status switch { ReceiptStatus.Completed => "bg-success", ReceiptStatus.Reversed or ReceiptStatus.Cancelled => "bg-secondary", ReceiptStatus.Exception => "bg-danger", _ => "bg-warning text-dark" })">@receipt.Status</span></td><td><a asp-action="Details" asp-route-id="@receipt.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td></tr> }
    </tbody></table></div>
        @if (Model.TotalPages > 1) { <div class="card-footer bg-white d-flex justify-content-between align-items-center"><span class="text-muted">@T["AdvanceShippingNotices.PageOf", Model.Page, Model.TotalPages]</span><div class="btn-group">@if (Model.Page > 1){<a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm" asp-route-warehouseId="@Model.WarehouseId" asp-route-supplierId="@Model.SupplierId" asp-route-status="@Model.Status" class="btn btn-outline-secondary">@T["Common.Previous"]</a>}@if (Model.Page < Model.TotalPages){<a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-searchTerm="@Model.SearchTerm" asp-route-warehouseId="@Model.WarehouseId" asp-route-supplierId="@Model.SupplierId" asp-route-status="@Model.Status" class="btn btn-outline-secondary">@T["Common.Next"]</a>}</div></div> }
    }
</div>
