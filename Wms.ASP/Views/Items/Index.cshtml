@model ItemManagementViewModel
@{
    ViewData["Title"] = T["Items.Title"];
    var canManageItems = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.ItemsManage)).Succeeded;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-box me-2 text-primary"></i>
        @T["Items.Title"]
    </h2>
    @if (canManageItems)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            @T["Items.Add"]
        </a>
    }
</div>

<!-- Search Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="searchTerm" class="form-label">@T["Items.Search"]</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control" id="searchTerm" name="searchTerm"
                           value="@Model.SearchTerm" placeholder="@T["Items.SearchPlaceholder"]">
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        @T["Common.Search"]
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>
                        @T["Common.Clear"]
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Items Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom">
        <h5 class="card-title mb-0">
            <i class="bi bi-list-ul me-2 text-primary"></i>
            @T["Items.List"] (@Model.Items.Count)
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>@T["Field.ItemSku"]</th>
                        <th>@T["Field.Name"]</th>
                        <th>@T["Field.Description"]</th>
                        <th>@T["Field.UnitOfMeasure"]</th>
                        <th class="text-center">@T["Items.LotTracking"]</th>
                        <th class="text-center">@T["Items.SerialTracking"]</th>
                        <th class="text-center">@T["Field.Status"]</th>
                        <th class="text-center">@T["Common.Actions"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsActive ? "" : "table-secondary")">
                            <td class="fw-medium">
                                <code class="wms-identifier">@item.Sku</code>
                            </td>
                            <td>
                                <div class="fw-medium">@item.Name</div>
                                @if (item.Barcodes.Any())
                                {
                                    <small class="text-muted wms-identifier">@T["Items.BarcodeList", string.Join(", ", item.Barcodes.Take(2))]</small>
                                }
                            </td>
                            <td>
                                <span class="text-muted">@(string.IsNullOrEmpty(item.Description) ? T["Items.NoDescription"] : item.Description)</span>
                            </td>
                            <td>
                                <span class="badge bg-info">@item.UnitOfMeasure</span>
                            </td>
                            <td class="text-center">
                                @if (item.RequiresLot)
                                {
                                    <i class="bi bi-check-circle text-success" title="@T["Items.RequiresLot"]"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle text-muted" title="@T["Items.LotTracking"]"></i>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.RequiresSerial)
                                {
                                    <i class="bi bi-check-circle text-success" title="@T["Items.RequiresSerial"]"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle text-muted" title="@T["Items.SerialTracking"]"></i>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">@T["Common.Active"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@T["Common.Inactive"]</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (canManageItems)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary" title="@T["Items.Edit"]">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    <a asp-controller="Inventory" asp-action="Index" asp-route-searchTerm="@item.Sku"
                                       class="btn btn-outline-info" title="@T["Items.ViewStock"]">
                                        <i class="bi bi-stack"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 mb-3"></i>
                <p class="mb-0">@T["Items.NoItems"]</p>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <p>@T["Locations.NoSearchResults"]</p>
                }
                else
                {
                    <p>@T["Common.GetStarted"]</p>
                    @if (canManageItems)
                    {
                        <a asp-action="Create" class="btn btn-primary mt-2">
                            <i class="bi bi-plus-circle me-1"></i>
                            @T["Items.Add"]
                        </a>
                    }
                }
            </div>
        }
    </div>
</div>
