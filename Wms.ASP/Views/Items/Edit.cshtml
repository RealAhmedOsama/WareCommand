@model ItemFormViewModel
@{
    ViewData["Title"] = T["Items.Edit"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>@T["Items.Edit"]</h2>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@T["Common.Back"]</a>
</div>

<partial name="_ItemForm" model="Model" />

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
