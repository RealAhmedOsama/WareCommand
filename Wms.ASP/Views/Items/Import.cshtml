@model ItemImportViewModel
@{
    ViewData["Title"] = T["Items.Import"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-upload me-2 text-primary"></i>@T["Items.Import"]</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@T["Common.Back"]</a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Items.ImportInstructions"]</h5></div>
            <div class="card-body">
                <p class="text-muted">@T["Items.ImportHelp"]</p>
                <div class="alert alert-secondary small wms-identifier">SKU,NAME,BASE_UNIT,CATEGORY,BRAND,TYPE,STATUS,PURCHASE_UNIT,SALES_UNIT,REQUIRES_LOT,REQUIRES_SERIAL,REQUIRES_EXPIRY,SHELF_LIFE_DAYS,USE_FEFO,STANDARD_COST,MINIMUM_STOCK,MAXIMUM_STOCK,SAFETY_STOCK,LEAD_TIME_DAYS,STORAGE_PROFILE,PUTAWAY_PROFILE,DEFAULT_SUPPLIER_CODE</div>
                <form asp-action="Import" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="File" class="form-label">@T["Items.ImportFile"]</label>
                        <input asp-for="File" class="form-control" type="file" accept=".csv,text/csv" />
                    </div>
                    <div class="text-center text-muted mb-3">@T["Common.Or"]</div>
                    <div class="mb-3">
                        <label asp-for="Csv" class="form-label">@T["Items.PasteCsv"]</label>
                        <textarea asp-for="Csv" class="form-control wms-identifier" rows="12"></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Cancel"]</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>@T["Items.Import"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
