@model ItemDuplicateViewModel
@{
    ViewData["Title"] = T["Items.Duplicate"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-copy me-2 text-primary"></i>@T["Items.Duplicate"]</h2>
    <a asp-action="Details" asp-route-id="@Model.SourceItemId" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>@T["Common.Back"]</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Items.DuplicateSource"]</h5></div>
            <div class="card-body">
                @if (Model.SourceItem is not null)
                {
                    <p class="text-muted"><code class="wms-identifier">@Model.SourceItem.Sku</code> — @Model.SourceItem.Name</p>
                }
                <form asp-action="Duplicate" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="SourceItemId" type="hidden" />
                    <div class="mb-3"><label asp-for="Sku" class="form-label">@T["Field.ItemSku"]</label><input asp-for="Sku" class="form-control wms-identifier" /><span asp-validation-for="Sku" class="text-danger"></span></div>
                    <div class="mb-3"><label asp-for="Name" class="form-label">@T["Field.Name"]</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
                    <div class="form-check form-switch mb-4"><input asp-for="CopyPackagings" class="form-check-input" /><label asp-for="CopyPackagings" class="form-check-label">@T["Items.CopyPackagings"]</label></div>
                    <div class="d-flex justify-content-end gap-2"><a asp-action="Details" asp-route-id="@Model.SourceItemId" class="btn btn-outline-secondary">@T["Common.Cancel"]</a><button type="submit" class="btn btn-primary">@T["Items.Duplicate"]</button></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
