@model Wms.Application.Suppliers.SupplierDto
@{
    ViewData["Title"] = T["Suppliers.Details"];
    var canManage = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.SuppliersManage)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><h2 class="mb-1"><i class="bi bi-truck me-2 text-primary"></i>@Model.Code</h2><p class="text-muted mb-0">@Model.LegalName</p></div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Back"]</a>
        @if (canManage)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>@T["Common.Edit"]</a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Suppliers.Profile"]</h5></div>
            <div class="card-body"><dl class="row mb-0">
                <dt class="col-sm-5">@T["Suppliers.LegalName"]</dt><dd class="col-sm-7">@Model.LegalName</dd>
                <dt class="col-sm-5">@T["Suppliers.LocalizedName"]</dt><dd class="col-sm-7">@(Model.LocalizedName ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-5">@T["Suppliers.TaxRegistration"]</dt><dd class="col-sm-7">@(Model.TaxRegistrationNumber ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-5">@T["Suppliers.ExternalErp"]</dt><dd class="col-sm-7">@(Model.ExternalErpIdentifier ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-5">@T["Suppliers.Contact"]</dt><dd class="col-sm-7">@(Model.ContactName ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-5">@T["Suppliers.ContactEmail"]</dt><dd class="col-sm-7">@(Model.ContactEmail ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-5">@T["Suppliers.ContactPhone"]</dt><dd class="col-sm-7">@(Model.ContactPhone ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-5">@T["Suppliers.Address"]</dt><dd class="col-sm-7">@string.Join(", ", new[] { Model.AddressLine1, Model.AddressLine2, Model.City, Model.StateOrProvince, Model.PostalCode, Model.CountryCode }.Where(value => !string.IsNullOrWhiteSpace(value)))</dd>
                <dt class="col-sm-5">@T["Field.Status"]</dt><dd class="col-sm-7"><span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? T["Common.Active"] : T["Common.Inactive"])</span></dd>
            </dl></div>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Suppliers.ItemReferences"]</h5></div>
            @if (Model.ItemReferences.Count == 0)
            {
                <div class="card-body text-muted">@T["Suppliers.NoItemReferences"]</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>@T["Items.Sku"]</th><th>@T["Suppliers.VendorSku"]</th><th>@T["Suppliers.VendorBarcode"]</th><th>@T["Items.PackagingCode"]</th><th>@T["Field.Status"]</th></tr></thead><tbody>
                @foreach (var reference in Model.ItemReferences)
                {
                    <tr><td>@reference.ItemSku</td><td>@reference.VendorSku</td><td>@(reference.VendorBarcode ?? T["Common.NotSet"])</td><td>@(reference.ItemPackagingCode ?? reference.VendorPackaging ?? T["Common.NotSet"])</td><td><span class="badge @(reference.IsActive ? "bg-success" : "bg-secondary")">@(reference.IsActive ? T["Common.Active"] : T["Common.Inactive"])</span></td></tr>
                }
                </tbody></table></div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white"><h5 class="mb-0">@T["Suppliers.ReceivingDefaults"]</h5></div>
            <div class="card-body"><dl class="row mb-0">
                <dt class="col-sm-7">@T["Suppliers.Warehouse"]</dt><dd class="col-sm-5">@(Model.PreferredWarehouseCode ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-7">@T["Suppliers.Dock"]</dt><dd class="col-sm-5">@(Model.PreferredDockCode ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-7">@T["Suppliers.LeadTime"]</dt><dd class="col-sm-5">@(Model.DefaultLeadTimeDays?.ToString() ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-7">@T["Suppliers.OverTolerance"]</dt><dd class="col-sm-5">@(Model.OverDeliveryTolerancePercent?.ToString() ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-7">@T["Suppliers.UnderTolerance"]</dt><dd class="col-sm-5">@(Model.UnderDeliveryTolerancePercent?.ToString() ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-7">@T["Suppliers.LotRequired"]</dt><dd class="col-sm-5">@(Model.RequiresLot ? T["Common.Yes"] : T["Common.No"])</dd>
                <dt class="col-sm-7">@T["Suppliers.ExpiryRequired"]</dt><dd class="col-sm-5">@(Model.RequiresExpiry ? T["Common.Yes"] : T["Common.No"])</dd>
                <dt class="col-sm-7">@T["Suppliers.QualityProfile"]</dt><dd class="col-sm-5">@(Model.QualityProfile ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-7">@T["Suppliers.LabelRule"]</dt><dd class="col-sm-5">@(Model.LabelRule ?? T["Common.NotSet"])</dd>
                <dt class="col-sm-7">@T["Suppliers.Currency"]</dt><dd class="col-sm-5">@(Model.DefaultCurrencyCode ?? T["Common.NotSet"])</dd>
            </dl></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card shadow-sm border-0"><div class="card-header bg-white"><h5 class="mb-0">@T["Suppliers.Notes"]</h5></div><div class="card-body">@Model.Notes</div></div>
        }
    </div>
</div>
