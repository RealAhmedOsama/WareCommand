@model SupplierFormViewModel
@{ ViewData["Title"] = T["Suppliers.Create"]; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2 class="mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>@T["Suppliers.Create"]</h2><a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Cancel"]</a></div>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <partial name="_Form" model="Model" />
    <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Cancel"]</a><button type="submit" class="btn btn-primary">@T["Common.Create"]</button></div>
</form>
