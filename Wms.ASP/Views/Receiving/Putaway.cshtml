@model PutawayViewModel
@{
    ViewData["Title"] = T["Putaway.Title"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-box-arrow-right me-2 text-info"></i>
        @T["Putaway.Title"]
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow">
            <div class="card-header bg-info bg-opacity-10 border-bottom">
                <h5 class="card-title mb-0 text-info">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    @T["Putaway.CardTitle"]
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Putaway" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <!-- Item Information -->
                        <div class="col-md-6">
                            <label for="ItemSku" class="form-label">@T["Field.ItemSku"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-upc-scan"></i>
                                </span>
                                <input asp-for="ItemSku" class="form-control" placeholder="@T["Receiving.ScanSku"]" required autofocus/>
                            </div>
                            <span asp-validation-for="ItemSku" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="Quantity" class="form-label">@T["Field.Quantity"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-123"></i>
                                </span>
                                <input asp-for="Quantity" class="form-control" type="number" step="0.01" min="0.01" required/>
                            </div>
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UnitOfMeasure" class="form-label">@T["Field.UnitOfMeasure"]</label>
                            <input asp-for="UnitOfMeasure" class="form-control" maxlength="20" placeholder="@T["Uom.EnterCode"]" />
                            <span class="form-text">@T["Uom.OptionalOperationUnit"]</span>
                            <span asp-validation-for="UnitOfMeasure" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PackagingCode" class="form-label">@T["Items.PackagingCode"]</label>
                            <input asp-for="PackagingCode" class="form-control wms-identifier" maxlength="40" placeholder="@T["Items.PackagingCode"]" />
                            <span asp-validation-for="PackagingCode" class="text-danger"></span>
                        </div>

                        <!-- Location Information -->
                        <div class="col-md-6">
                            <label for="FromLocationCode" class="form-label">@T["Field.FromLocation"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <input asp-for="FromLocationCode" class="form-control" placeholder="@T["Putaway.Source"]" required/>
                            </div>
                            <span asp-validation-for="FromLocationCode" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="ToLocationCode" class="form-label">@T["Field.ToLocation"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </span>
                                <input asp-for="ToLocationCode" class="form-control" placeholder="@T["Putaway.Destination"]" required/>
                            </div>
                            <span asp-validation-for="ToLocationCode" class="text-danger"></span>
                        </div>

                        <!-- Optional Fields -->
                        <div class="col-md-6">
                            <label for="LotNumber" class="form-label">@T["Field.LotNumber"]</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-tag"></i>
                                </span>
                                <input asp-for="LotNumber" class="form-control" placeholder="@T["Receiving.EnterLot"]"/>
                            </div>
                            <span asp-validation-for="LotNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label for="SerialNumber" class="form-label">@T["Field.SerialNumber"]</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-qr-code"></i>
                                </span>
                                <input asp-for="SerialNumber" class="form-control" placeholder="@T["Receiving.EnterSerial"]"/>
                            </div>
                            <span asp-validation-for="SerialNumber" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label for="Notes" class="form-label">@T["Field.Notes"]</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="@T["Putaway.EnterNotes"]"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-12 pt-3">
                            <div class="d-flex gap-2 justify-content-end">
                                <button type="button" class="btn btn-outline-secondary" data-clear-form data-focus-field="ItemSku">
                                    <i class="bi bi-arrow-clockwise me-1"></i>
                                    @T["Common.Clear"]
                                </button>
                                <button type="submit" class="btn btn-info">
                                    <i class="bi bi-check-circle me-1"></i>
                                    @T["Putaway.Submit"]
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-light border-bottom">
                <h6 class="card-title mb-0">
                    <i class="bi bi-lightning me-2"></i>
                    @T["Common.Actions"]
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-6">
                        <a asp-action="Receive" class="btn btn-outline-success w-100">
                            <i class="bi bi-box-arrow-in-down me-2"></i>
                            @T["Nav.Receiving"]
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-primary w-100">
                            <i class="bi bi-stack me-2"></i>
                            @T["Nav.Inventory"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script nonce="@Context.Items[SecurityHeadersMiddleware.ContentSecurityPolicyNonceItem]">
        function clearForm() {
            $('form')[0].reset();
            $('#ItemSku').focus();
        }

        $(document).ready(function() {
            // Focus on SKU input after successful submission
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                setTimeout(function() {
                    $('#ItemSku').focus();
                }, 100);
                </text>
            }

            // Enter key navigation
            $('input').on('keypress', function(e) {
                if (e.which === 13 && !$(this).is('input[type="submit"]')) {
                    e.preventDefault();
                    var inputs = $('input[type!="hidden"]:visible');
                    var nextInput = inputs.eq(inputs.index(this) + 1);
                    if (nextInput.length) {
                        nextInput.focus();
                    } else {
                        $('button[type="submit"]').focus();
                    }
                }
            });
        });
    </script>
}
