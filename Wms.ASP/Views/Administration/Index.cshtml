@using System.Globalization
@using Wms.Application.Administration
@using Wms.Application.Auditing
@model AdministrationIndexViewModel
@{
    ViewData["Title"] = "Administration";
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var visibleModules = Model.Modules.Where(module => module.IsAuthorized).ToArray();
    var groups = visibleModules
        .GroupBy(module => isRtl ? module.CategoryArabic : module.Category)
        .OrderBy(group => group.Key, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();
    var readiness = Model.Readiness;
    var history = Model.History;
    var page = history?.Page ?? 1;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <p class="text-uppercase text-muted small fw-semibold mb-1">@(isRtl ? "التحكم التشغيلي" : "Operational control")</p>
            <h1 class="h2 mb-1">@(isRtl ? "الإدارة والتشغيل" : "Administration and operations")</h1>
            <p class="text-muted mb-0">
                @(isRtl
                    ? "مدخل موحد للأسطح المصرح بها مع فحص جاهزية من الخادم وسجل تغييرات مقسّم إلى صفحات."
                    : "A permission-controlled entry point with server-side readiness checks and paged change history.")
            </p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Audit" asp-action="Index">
            <i class="bi bi-journal-text me-1" aria-hidden="true"></i>
            @(isRtl ? "فتح سجل التدقيق" : "Open audit log")
        </a>
    </div>

    <div class="alert alert-info d-flex gap-3 align-items-start" role="note">
        <i class="bi bi-shield-lock fs-4" aria-hidden="true"></i>
        <div>
            <strong>@(isRtl ? "حد الأمان" : "Security boundary")</strong>
            <div>
                @(isRtl
                    ? "لا تعرض هذه الشاشة أسراراً ولا تسمح بتعديل قاعدة البيانات مباشرة. إعدادات النشر والاعتمادات السرية للقراءة التشخيصية فقط وتبقى خارج وحدة الإدارة."
                    : "This console never displays secrets and does not provide direct database editing. Deployment settings and credentials remain outside the administration surface.")
            </div>
        </div>
    </div>

    @if (readiness is not null)
    {
        var readinessClass = readiness.OverallStatus switch
        {
            AdministrationReadinessStatus.Ready => "success",
            AdministrationReadinessStatus.Warning => "warning",
            _ => "danger"
        };
        <section class="mb-5" aria-labelledby="readiness-heading">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
                <div>
                    <h2 id="readiness-heading" class="h4 mb-1">@(isRtl ? "ملخص الجاهزية" : "Readiness summary")</h2>
                    <p class="text-muted mb-0">
                        @(isRtl
                            ? "يحدد هذا الملخص العوائق التي تمنع تنفيذ الوارد أو الصادر قبل التفعيل."
                            : "The server identifies blockers for inbound and outbound execution before activation.")
                    </p>
                </div>
                <span class="badge text-bg-@readinessClass fs-6">
                    @(isRtl ? readiness.OverallStatus switch
                    {
                        AdministrationReadinessStatus.Ready => "جاهز",
                        AdministrationReadinessStatus.Warning => "تحذير",
                        _ => "متوقف"
                    } : readiness.OverallStatus.ToString())
                </span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6 col-xl-3"><div class="card h-100 border-success"><div class="card-body"><div class="text-muted small">@(isRtl ? "جاهز" : "Ready")</div><div class="display-6">@readiness.ReadyCount</div></div></div></div>
                <div class="col-6 col-xl-3"><div class="card h-100 border-warning"><div class="card-body"><div class="text-muted small">@(isRtl ? "تحذير" : "Warnings")</div><div class="display-6">@readiness.WarningCount</div></div></div></div>
                <div class="col-6 col-xl-3"><div class="card h-100 border-danger"><div class="card-body"><div class="text-muted small">@(isRtl ? "عوائق" : "Blockers")</div><div class="display-6">@readiness.BlockedCount</div></div></div></div>
                <div class="col-6 col-xl-3"><div class="card h-100"><div class="card-body"><div class="text-muted small">@(isRtl ? "تاريخ التحديث" : "Checked")</div><div class="small mt-2"><time datetime="@readiness.GeneratedAtUtc.ToString("O")">@readiness.GeneratedAtUtc.ToLocalTime().ToString("g")</time></div></div></div></div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <caption class="visually-hidden">@(isRtl ? "فحوصات جاهزية الإدارة" : "Administration readiness checks")</caption>
                    <thead><tr><th scope="col">@(isRtl ? "الفحص" : "Check")</th><th scope="col">@(isRtl ? "الحالة" : "Status")</th><th scope="col">@(isRtl ? "التفاصيل" : "Details")</th><th scope="col">@(isRtl ? "الإجراء" : "Action")</th></tr></thead>
                    <tbody>
                    @foreach (var check in readiness.Checks)
                    {
                        var checkClass = check.Status switch
                        {
                            AdministrationReadinessStatus.Ready => "success",
                            AdministrationReadinessStatus.Warning => "warning",
                            _ => "danger"
                        };
                        <tr>
                            <th scope="row">@(isRtl ? check.TitleArabic : check.Title)</th>
                            <td><span class="badge text-bg-@checkClass">@(isRtl ? check.Status switch
                                {
                                    AdministrationReadinessStatus.Ready => "جاهز",
                                    AdministrationReadinessStatus.Warning => "تحذير",
                                    _ => "متوقف"
                                } : check.Status.ToString())</span>@if (check.IsBlocking) { <span class="visually-hidden"> @(isRtl ? "عائق" : "blocking")</span> }</td>
                            <td>@(isRtl ? check.DetailArabic : check.Detail)</td>
                            <td><a href="@check.Route" class="btn btn-sm btn-outline-secondary">@(isRtl ? "مراجعة" : "Review")</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="mb-5" aria-labelledby="catalog-heading">
        <div class="mb-3">
            <h2 id="catalog-heading" class="h4 mb-1">@(isRtl ? "كتالوج الإدارة" : "Administration catalog")</h2>
            <p class="text-muted mb-0">@(isRtl ? "تظهر هنا الأسطح التي يسمح بها نطاق صلاحياتك؛ كل وحدة تظل مسؤولة عن التحقق والتدقيق الخاص بها." : "Only authorized surfaces are shown; each owning module keeps its own validation, scope, and audit boundary.")</p>
        </div>
        @if (groups.Length == 0)
        {
            <div class="alert alert-warning" role="status">@(isRtl ? "لا توجد أسطح إدارة متاحة ضمن صلاحياتك الحالية." : "No administration surfaces are available for your current permissions.")</div>
        }
        else
        {
            @foreach (var group in groups)
            {
                <h3 class="h5 mt-4">@group.Key</h3>
                <div class="row g-3">
                    @foreach (var module in group)
                    {
                        var title = isRtl ? module.TitleArabic : module.Title;
                        var description = isRtl ? module.DescriptionArabic : module.Description;
                        <div class="col-12 col-md-6 col-xl-4">
                            <article class="card h-100 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between gap-2 mb-2">
                                        <h4 class="h6 mb-0">@title</h4>
                                        <span class="badge text-bg-@(module.Status == AdministrationSurfaceStatus.Ready ? "success" : module.Status == AdministrationSurfaceStatus.Partial ? "warning" : "secondary")">@module.Status</span>
                                    </div>
                                    <p class="small text-muted flex-grow-1">@description</p>
                                    <div class="small mb-3">
                                        <span class="text-muted">@(isRtl ? "الصلاحية:" : "Permission:")</span>
                                        <code>@module.RequiredPermission</code>
                                        @if (module.SecretPolicy != AdministrationSecretPolicy.NotApplicable)
                                        {
                                            <span class="badge text-bg-light border ms-1">@(isRtl ? "الأسرار محمية" : "Secrets protected")</span>
                                        }
                                    </div>
                                    <a class="btn btn-outline-primary btn-sm align-self-start" href="@module.Route">
                                        @(isRtl ? "فتح الوحدة" : "Open module") <span aria-hidden="true">↗</span>
                                    </a>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
        }
    </section>

    <section aria-labelledby="history-heading">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-3">
            <div>
                <h2 id="history-heading" class="h4 mb-1">@(isRtl ? "آخر تغييرات الإدارة" : "Recent administration changes")</h2>
                <p class="text-muted mb-0">@(isRtl ? "النتائج مقسمة إلى صفحات وتقرأ من سجل التدقيق غير القابل للتعديل." : "Results are server-paged and read from immutable audit history.")</p>
            </div>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Audit" asp-action="Index">@(isRtl ? "كل السجل" : "Full history")</a>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.HistoryError))
        {
            <div class="alert alert-warning" role="status">@Model.HistoryError</div>
        }
        else if (history is null || history.Items.Count == 0)
        {
            <div class="alert alert-light border" role="status">@(isRtl ? "لا توجد تغييرات مسجلة ضمن النطاق الحالي." : "No changes are recorded in the current scope.")</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <caption class="visually-hidden">@(isRtl ? "تغييرات الإدارة الأخيرة" : "Recent administration changes")</caption>
                    <thead><tr><th scope="col">@(isRtl ? "الوقت" : "Time")</th><th scope="col">@(isRtl ? "الفاعل" : "Actor")</th><th scope="col">@(isRtl ? "الإجراء" : "Action")</th><th scope="col">@(isRtl ? "الكيان" : "Entity")</th><th scope="col">@(isRtl ? "المستودع" : "Warehouse")</th><th scope="col">@(isRtl ? "النتيجة" : "Result")</th></tr></thead>
                    <tbody>
                    @foreach (var entry in history.Items)
                    {
                        <tr>
                            <td><time datetime="@entry.OccurredAtUtc.ToString("O")">@entry.OccurredAtUtc.ToLocalTime().ToString("g")</time></td>
                            <td>@(entry.ActorUserName ?? entry.ActorUserId ?? (isRtl ? "النظام" : "System"))</td>
                            <td><code>@entry.Action</code></td>
                            <td>@entry.EntityType <small class="text-muted">@entry.EntityId</small></td>
                            <td>@(entry.WarehouseCode ?? (isRtl ? "عام" : "Global"))</td>
                            <td><span class="badge text-bg-@(entry.Succeeded ? "success" : "danger")">@(entry.Succeeded ? (isRtl ? "نجح" : "Success") : (isRtl ? "فشل" : "Failed"))</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (history.TotalPages > 1)
            {
                <nav aria-label="@(isRtl ? "صفحات سجل الإدارة" : "Administration history pages")">
                    <ul class="pagination pagination-sm">
                        <li class="page-item @(history.Page <= 1 ? "disabled" : string.Empty)"><a class="page-link" asp-action="Index" asp-route-warehouseId="@Model.WarehouseId" asp-route-page="@(history.Page - 1)">@(isRtl ? "السابق" : "Previous")</a></li>
                        <li class="page-item disabled"><span class="page-link">@history.Page / @history.TotalPages</span></li>
                        <li class="page-item @(history.Page >= history.TotalPages ? "disabled" : string.Empty)"><a class="page-link" asp-action="Index" asp-route-warehouseId="@Model.WarehouseId" asp-route-page="@(history.Page + 1)">@(isRtl ? "التالي" : "Next")</a></li>
                    </ul>
                </nav>
            }
        }
    </section>
</div>
