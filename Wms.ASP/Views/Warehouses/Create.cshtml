@model CreateWarehouseViewModel
@{
    ViewData["Title"] = T["Warehouses.Create"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-building-add me-2 text-primary"></i>@T["Warehouses.Create"]</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Back"]</a>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <partial name="_Form" model="Model" />
    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Cancel"]</a>
        <button type="submit" class="btn btn-primary">@T["Warehouses.Create"]</button>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
