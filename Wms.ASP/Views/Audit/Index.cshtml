@model Wms.ASP.Models.AuditLogViewModel
@{
    ViewData["Title"] = T["Audit.Title"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@T["Audit.Title"]</h1>
        <p class="text-muted mb-0">@T["Audit.Subtitle"]</p>
    </div>
</div>

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-2">
                <label asp-for="FromDate" class="form-label">@T["Audit.FromDate"]</label>
                <input asp-for="FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="ToDate" class="form-label">@T["Audit.ToDate"]</label>
                <input asp-for="ToDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="UserId" class="form-label">@T["Audit.UserId"]</label>
                <input asp-for="UserId" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-2">
                <label asp-for="WarehouseId" class="form-label">@T["Audit.WarehouseFilter"]</label>
                <select asp-for="WarehouseId" class="form-select">
                    <option value="">@T["Audit.AllWarehouses"]</option>
                    @foreach (var warehouse in Model.Warehouses)
                    {
                        <option value="@warehouse.Id">@warehouse.Code — @warehouse.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Action" class="form-label">@T["Audit.Action"]</label>
                <select asp-for="Action" class="form-select">
                    <option value="">@T["Audit.AllActions"]</option>
                    @foreach (var action in Model.Actions)
                    {
                        <option value="@action">@action</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="EntityType" class="form-label">@T["Audit.Entity"]</label>
                <select asp-for="EntityType" class="form-select">
                    <option value="">@T["Audit.AllEntities"]</option>
                    @foreach (var entityType in Model.EntityTypes)
                    {
                        <option value="@entityType">@entityType</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">@T["Common.Search"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Clear"]</a>
            <a asp-action="Export"
               asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-UserId="@Model.UserId"
               asp-route-WarehouseId="@Model.WarehouseId"
               asp-route-Action="@Model.Action"
               asp-route-EntityType="@Model.EntityType"
               class="btn btn-outline-secondary">@T["Common.ExportCsv"]</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between">
        <span>@T["Common.Entries"]</span>
        <span class="text-muted">@Model.TotalCount @T["Common.Total"]</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>@T["Audit.UtcTime"]</th>
                <th>@T["Audit.Actor"]</th>
                <th>@T["Audit.Action"]</th>
                <th>@T["Audit.Entity"]</th>
                <th>@T["Audit.Warehouse"]</th>
                <th>@T["Audit.Source"]</th>
                <th>@T["Audit.Correlation"]</th>
                <th>@T["Audit.Changes"]</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Entries.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">@T["Audit.NoEntries"]</td></tr>
            }
            else
            {
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td class="text-nowrap">@entry.OccurredAtUtc.ToString("u")</td>
                        <td class="wms-identifier">@(entry.ActorUserName ?? entry.ActorUserId ?? T["Common.System"])</td>
                        <td><code class="wms-identifier">@entry.Action</code></td>
                        <td><code class="wms-identifier">@entry.EntityType:@entry.EntityId</code></td>
                        <td class="wms-identifier">@(entry.WarehouseCode ?? entry.WarehouseId?.ToString() ?? T["Settings.GlobalDefaults"])</td>
                        <td>@entry.SourceClient</td>
                        <td><code>@entry.CorrelationId</code></td>
                        <td>
                            @if (entry.BeforeJson is not null || entry.AfterJson is not null)
                            {
                                <details>
                                <summary>@T["Common.View"]</summary>
                                    @if (entry.BeforeJson is not null)
                                    {
                                        <strong>@T["Common.Before"]</strong>
                                        <pre class="small">@entry.BeforeJson</pre>
                                    }
                                    @if (entry.AfterJson is not null)
                                    {
                                        <strong>@T["Common.After"]</strong>
                                        <pre class="small">@entry.AfterJson</pre>
                                    }
                                </details>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="@T["Audit.Pages"]">
        <ul class="pagination">
            @for (var page = 1; page <= Model.TotalPages; page++)
            {
                <li class="page-item @(page == Model.Page ? "active" : null)">
                    <a class="page-link" asp-action="Index"
                       asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                       asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                       asp-route-UserId="@Model.UserId"
                       asp-route-WarehouseId="@Model.WarehouseId"
                       asp-route-Action="@Model.Action"
                       asp-route-EntityType="@Model.EntityType"
                       asp-route-Page="@(page)"
                       asp-route-PageSize="@Model.PageSize">@(page)</a>
                </li>
            }
        </ul>
    </nav>
}
