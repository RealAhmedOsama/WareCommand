@model Wms.ASP.Models.AuditLogViewModel
@{
    ViewData["Title"] = "Audit log";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Audit log</h1>
        <p class="text-muted mb-0">Immutable security and warehouse activity history</p>
    </div>
</div>

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-2">
                <label asp-for="FromDate" class="form-label"></label>
                <input asp-for="FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="ToDate" class="form-label"></label>
                <input asp-for="ToDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="UserId" class="form-label"></label>
                <input asp-for="UserId" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-2">
                <label asp-for="WarehouseId" class="form-label"></label>
                <select asp-for="WarehouseId" class="form-select">
                    <option value="">All accessible warehouses</option>
                    @foreach (var warehouse in Model.Warehouses)
                    {
                        <option value="@warehouse.Id">@warehouse.Code — @warehouse.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Action" class="form-label"></label>
                <select asp-for="Action" class="form-select">
                    <option value="">All actions</option>
                    @foreach (var action in Model.Actions)
                    {
                        <option value="@action">@action</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="EntityType" class="form-label"></label>
                <select asp-for="EntityType" class="form-select">
                    <option value="">All entities</option>
                    @foreach (var entityType in Model.EntityTypes)
                    {
                        <option value="@entityType">@entityType</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            <a asp-action="Export"
               asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-UserId="@Model.UserId"
               asp-route-WarehouseId="@Model.WarehouseId"
               asp-route-Action="@Model.Action"
               asp-route-EntityType="@Model.EntityType"
               class="btn btn-outline-secondary">Export CSV</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between">
        <span>Entries</span>
        <span class="text-muted">@Model.TotalCount total</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>UTC time</th>
                <th>Actor</th>
                <th>Action</th>
                <th>Entity</th>
                <th>Warehouse</th>
                <th>Source</th>
                <th>Correlation</th>
                <th>Changes</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Entries.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No audit entries match the filters.</td></tr>
            }
            else
            {
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td class="text-nowrap">@entry.OccurredAtUtc.ToString("u")</td>
                        <td>@(entry.ActorUserName ?? entry.ActorUserId ?? "System")</td>
                        <td><code>@entry.Action</code></td>
                        <td><code>@entry.EntityType:@entry.EntityId</code></td>
                        <td>@(entry.WarehouseCode ?? entry.WarehouseId?.ToString() ?? "Global")</td>
                        <td>@entry.SourceClient</td>
                        <td><code>@entry.CorrelationId</code></td>
                        <td>
                            @if (entry.BeforeJson is not null || entry.AfterJson is not null)
                            {
                                <details>
                                    <summary>View</summary>
                                    @if (entry.BeforeJson is not null)
                                    {
                                        <strong>Before</strong>
                                        <pre class="small">@entry.BeforeJson</pre>
                                    }
                                    @if (entry.AfterJson is not null)
                                    {
                                        <strong>After</strong>
                                        <pre class="small">@entry.AfterJson</pre>
                                    }
                                </details>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Audit pages">
        <ul class="pagination">
            @for (var page = 1; page <= Model.TotalPages; page++)
            {
                <li class="page-item @(page == Model.Page ? "active" : null)">
                    <a class="page-link" asp-action="Index"
                       asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                       asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                       asp-route-UserId="@Model.UserId"
                       asp-route-WarehouseId="@Model.WarehouseId"
                       asp-route-Action="@Model.Action"
                       asp-route-EntityType="@Model.EntityType"
                       asp-route-Page="@(page)"
                       asp-route-PageSize="@Model.PageSize">@(page)</a>
                </li>
            }
        </ul>
    </nav>
}
