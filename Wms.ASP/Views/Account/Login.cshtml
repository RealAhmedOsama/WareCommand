@model Wms.ASP.Models.LoginViewModel
@{
    ViewData["Title"] = T["Account.SignIn"];
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@T["Account.SignInTitle"]</h1>
                <p class="text-muted">@T["Account.SignInHelp"]</p>
                <form asp-action="Login" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">@T["Account.UsernameOrEmail"]</label>
                        <input asp-for="UserName" class="form-control wms-identifier" autocomplete="username" autofocus />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">@T["Account.Password"]</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">@T["Account.RememberMe"]</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@T["Account.SignIn"]</button>
                </form>
                <div class="mt-3 text-center">
                    <a asp-action="ForgotPassword">@T["Account.ForgotPassword"]</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
