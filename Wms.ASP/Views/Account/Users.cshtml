@model IReadOnlyList<Wms.ASP.Models.AccountUserViewModel>
@{
    ViewData["Title"] = T["Account.WarehouseAccounts"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@T["Account.WarehouseAccounts"]</h1>
        <p class="text-muted mb-0">@T["Account.AccountsHelp"]</p>
    </div>
    <a asp-action="CreateUser" class="btn btn-primary">@T["Account.CreateAccount"]</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>@T["Account.DisplayName"]</th>
            <th>@T["Account.Username"]</th>
            <th>@T["Account.EmployeeCode"]</th>
            <th>@T["Field.Status"]</th>
            <th>@T["Account.LastLogin"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.DisplayName<br /><small class="text-muted">@user.Email</small></td>
                <td>@user.UserName</td>
                <td>@user.EmployeeCode</td>
                <td>
                    @if (!user.IsActive)
                    {
                        <span class="badge text-bg-secondary">@T["Account.Disabled"]</span>
                    }
                    else if (user.IsLockedOut)
                    {
                        <span class="badge text-bg-warning">@T["Account.LockedStatus"]</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success">@T["Account.Active"]</span>
                    }
                </td>
                <td>@(user.LastLoginAtUtc?.ToString("g") ?? T["Account.Never"])</td>
                <td class="text-end">
                    <a asp-action="Access" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">@T["Account.ManageAccess"]</a>
                    <form asp-action="ToggleActive" method="post">
                        <input type="hidden" name="id" value="@user.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                            @(user.IsActive ? T["Account.Disable"] : T["Account.Enable"])
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
