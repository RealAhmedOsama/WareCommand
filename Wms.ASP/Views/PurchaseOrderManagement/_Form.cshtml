@model PurchaseOrderFormViewModel
@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="WarehouseId" class="form-label">@T["PurchaseOrders.Warehouse"]</label><select asp-for="WarehouseId" class="form-select"><option value="">@T["Common.Select"]</option>@foreach (var warehouse in Model.Warehouses){<option value="@warehouse.Id">@warehouse.Code - @warehouse.Name</option>}</select><span asp-validation-for="WarehouseId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="SupplierId" class="form-label">@T["PurchaseOrders.Supplier"]</label><select asp-for="SupplierId" class="form-select"><option value="">@T["Common.Select"]</option>@foreach (var supplier in Model.Suppliers){<option value="@supplier.Id">@supplier.Code - @supplier.Name @(supplier.IsActive ? "" : "(inactive)")</option>}</select><span asp-validation-for="SupplierId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="OrderDate" class="form-label">@T["PurchaseOrders.OrderDate"]</label><input asp-for="OrderDate" type="date" class="form-control" /><span asp-validation-for="OrderDate" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ExpectedReceiptDate" class="form-label">@T["PurchaseOrders.ExpectedReceipt"]</label><input asp-for="ExpectedReceiptDate" type="date" class="form-control" /></div><div class="col-md-4"><label asp-for="CurrencyCode" class="form-label">@T["PurchaseOrders.Currency"]</label><input asp-for="CurrencyCode" class="form-control" maxlength="3" /></div><div class="col-md-6"><label asp-for="ExternalReference" class="form-label">@T["PurchaseOrders.ExternalReference"]</label><input asp-for="ExternalReference" class="form-control" maxlength="100" /></div><div class="col-md-3"><label asp-for="SourceType" class="form-label">@T["PurchaseOrders.Source"]</label><input asp-for="SourceType" class="form-control" maxlength="30" /></div><div class="col-md-3"><label asp-for="SourceReference" class="form-label">@T["PurchaseOrders.SourceReference"]</label><input asp-for="SourceReference" class="form-control" maxlength="200" /></div><div class="col-12"><label asp-for="Notes" class="form-label">@T["PurchaseOrders.Notes"]</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div></div></div></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h5 class="mb-1">@T["PurchaseOrders.Lines"]</h5><small class="text-muted">@T["PurchaseOrders.LinesHelp"]</small></div><div class="card-body"><label asp-for="LinesText" class="form-label">@T["PurchaseOrders.LineRows"]</label><textarea asp-for="LinesText" class="form-control font-monospace" rows="8" placeholder="ITEM-SKU|10|EA|2|1|VENDOR-SKU|Notes"></textarea><span asp-validation-for="LinesText" class="text-danger"></span></div></div>
<div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Cancel"]</a><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@T["Common.Save"]</button></div>
