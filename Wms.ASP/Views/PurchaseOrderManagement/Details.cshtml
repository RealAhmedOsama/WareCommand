@model Wms.Application.Purchasing.PurchaseOrderDto
@{
    ViewData["Title"] = T["PurchaseOrders.Details"];
    var canManage = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.PurchaseOrdersManage)).Succeeded;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h2 class="mb-1"><i class="bi bi-clipboard-check me-2 text-primary"></i>@Model.DocumentNumber</h2><p class="text-muted mb-0">@Model.SupplierCode · @Model.WarehouseCode</p></div><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Back"]</a>@if (canManage && Model.CanEdit){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>@T["Common.Edit"]</a>}</div></div>

<div class="row g-4">
    <div class="col-lg-4"><div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h5 class="mb-0">@T["PurchaseOrders.Profile"]</h5></div><div class="card-body"><dl class="row mb-0"><dt class="col-6">@T["Field.Status"]</dt><dd class="col-6">@T[$"PurchaseOrders.Status.{Model.Status}"]</dd><dt class="col-6">@T["PurchaseOrders.Supplier"]</dt><dd class="col-6">@Model.SupplierCode</dd><dt class="col-6">@T["PurchaseOrders.Warehouse"]</dt><dd class="col-6">@Model.WarehouseCode</dd><dt class="col-6">@T["PurchaseOrders.OrderDate"]</dt><dd class="col-6">@Model.OrderDate.ToString("yyyy-MM-dd")</dd><dt class="col-6">@T["PurchaseOrders.ExpectedReceipt"]</dt><dd class="col-6">@(Model.ExpectedReceiptDate?.ToString("yyyy-MM-dd") ?? T["Common.NotSet"])</dd><dt class="col-6">@T["PurchaseOrders.ExternalReference"]</dt><dd class="col-6">@(Model.ExternalReference ?? T["Common.NotSet"])</dd><dt class="col-6">@T["PurchaseOrders.Source"]</dt><dd class="col-6">@Model.SourceType / @(Model.SourceReference ?? T["Common.NotSet"])</dd><dt class="col-6">@T["PurchaseOrders.Currency"]</dt><dd class="col-6">@(Model.CurrencyCode ?? T["Common.NotSet"])</dd></dl></div></div>
        @if (!string.IsNullOrWhiteSpace(Model.Notes)){<div class="card shadow-sm border-0"><div class="card-header bg-white"><h5 class="mb-0">@T["PurchaseOrders.Notes"]</h5></div><div class="card-body">@Model.Notes</div></div>}
    </div>
    <div class="col-lg-8"><div class="card shadow-sm border-0"><div class="card-header bg-white d-flex justify-content-between"><h5 class="mb-0">@T["PurchaseOrders.Lines"]</h5><span class="text-muted">@Model.Lines.Count</span></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>#</th><th>@T["Items.Sku"]</th><th class="text-end">@T["PurchaseOrders.Ordered"]</th><th class="text-end">@T["PurchaseOrders.Received"]</th><th class="text-end">@T["PurchaseOrders.Remaining"]</th><th>@T["PurchaseOrders.Tolerance"]</th></tr></thead><tbody>@foreach (var line in Model.Lines){<tr><td>@line.LineNumber</td><td><span class="fw-semibold">@line.ItemSku</span><br /><small class="text-muted">@line.ItemName</small></td><td class="text-end">@line.OrderedQuantity.ToString("N4") @line.OrderedUnitOfMeasure<br /><small class="text-muted">@line.OrderedBaseQuantity.ToString("N4") @line.BaseUnitOfMeasure</small></td><td class="text-end">@line.ReceivedQuantity.ToString("N4")<br /><small class="text-muted">@line.ReceivedBaseQuantity.ToString("N4") @line.BaseUnitOfMeasure</small></td><td class="text-end">@line.RemainingBaseQuantity.ToString("N4") @line.BaseUnitOfMeasure</td><td>+@line.OverDeliveryTolerancePercent.ToString("N2")% / -@line.UnderDeliveryTolerancePercent.ToString("N2")%</td></tr>}</tbody></table></div></div>
        @if (canManage){<div class="card shadow-sm border-0 mt-4"><div class="card-body d-flex flex-wrap gap-2">@if (Model.CanConfirm){<form asp-action="Confirm" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>@T["PurchaseOrders.Confirm"]</button></form>}@if (Model.CanCancel){<form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i>@T["PurchaseOrders.Cancel"]</button></form>}@if (Model.CanClose){<form asp-action="Close" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-success"><i class="bi bi-lock me-1"></i>@T["PurchaseOrders.Close"]</button></form>}@if (Model.CanReopen){<form asp-action="Reopen" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-warning"><i class="bi bi-unlock me-1"></i>@T["PurchaseOrders.Reopen"]</button></form>}</div></div>}
    </div>
</div>
