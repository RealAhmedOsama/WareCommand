@model PurchaseOrderImportViewModel
@{ ViewData["Title"] = T["PurchaseOrders.Import"]; }
<div class="mb-4"><h2><i class="bi bi-upload me-2 text-primary"></i>@T["PurchaseOrders.Import"]</h2><p class="text-muted">@T["PurchaseOrders.ImportHelp"]</p></div>
<form asp-action="Import" method="post" enctype="multipart/form-data"><div class="card shadow-sm border-0"><div class="card-body"><div class="mb-3"><label asp-for="File" class="form-label">@T["PurchaseOrders.ImportFile"]</label><input asp-for="File" type="file" accept=".csv,text/csv" class="form-control" /></div><div class="mb-3"><label asp-for="Csv" class="form-label">@T["PurchaseOrders.PasteCsv"]</label><textarea asp-for="Csv" class="form-control font-monospace" rows="12"></textarea></div><div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">@T["Common.Cancel"]</a><button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>@T["Common.Import"]</button></div></div></div></form>
