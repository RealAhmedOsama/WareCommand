@model ErrorViewModel
@{
    ViewData["Title"] = T["Error.Title"];
}

<h1 class="text-danger">@T["Error.Title"]</h1>
<h2 class="text-danger">@T["Error.Processing"]</h2>

@if (Model.ShowErrorReference)
{
    <p>
        <strong>@T["Error.Reference"]:</strong> <code class="wms-identifier">@Model.ErrorReference</code>
    </p>
}

@if (Model.ShowRequestId)
{
    <p>
        <strong>@T["Error.RequestId"]:</strong> <code class="wms-identifier">@Model.RequestId</code>
    </p>
}

<p>@T["Error.Retry"]</p>
