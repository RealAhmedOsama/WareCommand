<!DOCTYPE html>
@using Wms.Application.Context
@inject IWarehouseAccessService WarehouseAccessService
@inject IWarehouseContext WarehouseContext
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = currentCulture.TextInfo.IsRightToLeft;
    var languageReturnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var canDashboard = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.DashboardView)).Succeeded;
    var canReceive = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.ReceivingExecute)).Succeeded;
    var canPutaway = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.PutawayExecute)).Succeeded;
    var canPick = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.PickingExecute)).Succeeded;
    var canInventory = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.InventoryRead)).Succeeded;
    var canReports = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.ReportsRead)).Succeeded;
    var canItems = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.ItemsRead)).Succeeded;
    var canSuppliers = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.SuppliersRead)).Succeeded;
    var canPurchaseOrders = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.PurchaseOrdersRead)).Succeeded;
    var canAdvanceShippingNotices = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.AdvanceShippingNoticesRead)).Succeeded;
    var canReceipts = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.ReceiptsRead)).Succeeded;
    var canLocations = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.LocationsRead)).Succeeded;
    var canAudit = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.AuditRead)).Succeeded;
    var canWarehouses = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.WarehouseManage)).Succeeded;
    var canSettings = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.SettingsManage)).Succeeded;
    var canAccess = (await AuthorizationService.AuthorizeAsync(User, WmsPermissions.AccessManage)).Succeeded;
    var canAdministration = canAccess;
    var accessibleWarehouses = User.Identity?.IsAuthenticated == true
        ? await WarehouseAccessService.GetAccessibleWarehousesAsync(WmsPermissions.DashboardView)
        : Array.Empty<WmsWarehouseOption>();
    var layoutReturnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var scannerRoute = Context.Request.Path.Value?.StartsWith("/Receiving", StringComparison.OrdinalIgnoreCase) == true
        || Context.Request.Path.Value?.StartsWith("/Picking", StringComparison.OrdinalIgnoreCase) == true
        || Context.Request.Path.Value?.StartsWith("/WarehouseWork", StringComparison.OrdinalIgnoreCase) == true;
}
@* Authorization checks are evaluated before rendering navigation. *@
<html lang="@currentCulture.Name" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme-color" content="#0b4f6c"/>
    <meta name="mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/warecommand.svg" />
    <title>@ViewData["Title"] - @T["App.Name"]</title>
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css"/>
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Wms.ASP.styles.css" asp-append-version="true"/>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&amp;display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="wms-shell" data-wms-direction="@(isRtl ? "rtl" : "ltr")" data-wms-persistent-scan="@(scannerRoute ? "true" : "false")"
      data-wms-offline-message="@T["Pwa.Offline"]"
      data-wms-reconnecting-message="@T["Pwa.Reconnecting"]"
      data-wms-offline-mutation-message="@T["Pwa.OfflineMutationBlocked"]"
      data-wms-update-message="@T["Pwa.UpdateAvailable"]">
<a class="wms-skip-link" href="#main-content">@T["Shell.SkipToContent"]</a>
<header class="wms-shell-header">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-boxes me-2 fs-4"></i>
                <span class="d-none d-md-inline">@T["App.Name"]</span>
                <span class="d-md-none">@T["App.ShortName"]</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="@T["Nav.Management"]">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                <ul class="navbar-nav me-auto">
                    @if (canDashboard)
                    {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded-pill mx-1" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>@T["Nav.Dashboard"]
                        </a>
                    </li>
                    }
                    @if (canReceive || canPutaway || canPick)
                    {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle px-3 py-2 rounded-pill mx-1" href="#" id="operationsDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-arrow-repeat me-1"></i>@T["Nav.Operations"]
                        </a>
                        <ul class="dropdown-menu shadow border-0 mt-2">
                            @if (canReceive)
                            {
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Receiving" asp-action="Receive">
                                    <i class="bi bi-box-arrow-in-down me-2 text-success"></i>@T["Nav.Receiving"]
                                </a>
                            </li>
                            }
                            @if (canPutaway)
                            {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Receiving" asp-action="Putaway">
                                    <i class="bi bi-box-arrow-right me-2 text-info"></i>@T["Nav.Putaway"]
                                </a>
                            </li>
                            }
                            @if (canPick)
                            {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Picking" asp-action="Index">
                                    <i class="bi bi-box-arrow-up me-2 text-primary"></i>@T["Nav.Picking"]
                                </a>
                            </li>
                            }
                        </ul>
                    </li>
                    }
                    @if (canInventory)
                    {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded-pill mx-1" asp-controller="Inventory" asp-action="Index">
                            <i class="bi bi-stack me-1"></i>@T["Nav.Inventory"]
                        </a>
                    </li>
                    }
                    @if (canReports)
                    {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded-pill mx-1" asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-bar-chart-line me-1"></i>@T["Nav.Reports"]
                        </a>
                    </li>
                    }
                    @if (canItems || canSuppliers || canPurchaseOrders || canAdvanceShippingNotices || canReceipts || canLocations || canAudit || canWarehouses || canSettings || canAdministration)
                    {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle px-3 py-2 rounded-pill mx-1" href="#" id="managementDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-gear me-1"></i>@T["Nav.Management"]
                        </a>
                        <ul class="dropdown-menu shadow border-0 mt-2">
                            @if (canAdministration)
                            {
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Administration" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-2 text-primary"></i>@T["Nav.Administration"]
                                </a>
                            </li>
                            }
                            @if (canItems)
                            {
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Items" asp-action="Index">
                                    <i class="bi bi-box me-2 text-warning"></i>@T["Nav.Items"]
                                </a>
                            </li>
                            }
                            @if (canSuppliers)
                            {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="SupplierMaster" asp-action="Index">
                                    <i class="bi bi-truck me-2 text-info"></i>@T["Nav.Suppliers"]
                                </a>
                            </li>
                            }
                            @if (canPurchaseOrders)
                            {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="PurchaseOrderManagement" asp-action="Index">
                                    <i class="bi bi-clipboard-check me-2 text-primary"></i>@T["Nav.PurchaseOrders"]
                                </a>
                            </li>
                            }
                            @if (canAdvanceShippingNotices)
                            {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="AdvanceShippingNoticeManagement" asp-action="Index">
                                    <i class="bi bi-truck me-2 text-success"></i>@T["Nav.AdvanceShippingNotices"]
                                </a>
                            </li>
                            }
                            @if (canReceipts)
                            {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="ReceiptManagement" asp-action="Index">
                                    <i class="bi bi-box-seam me-2 text-warning"></i>@T["Nav.Receipts"]
                                </a>
                            </li>
                            }
                            @if (canLocations)
                            {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Locations" asp-action="Index">
                                    <i class="bi bi-geo-alt me-2 text-danger"></i>@T["Nav.Locations"]
                                </a>
                            </li>
                            }
                            @if (canWarehouses)
                            {
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Warehouses" asp-action="Index">
                                    <i class="bi bi-building me-2 text-success"></i>@T["Nav.Warehouses"]
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="UnitsOfMeasure" asp-action="Index">
                                    <i class="bi bi-rulers me-2 text-primary"></i>@T["Nav.UnitsOfMeasure"]
                                </a>
                            </li>
                            }
                            @if (canAudit)
                            {
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Audit" asp-action="Index">
                                    <i class="bi bi-shield-check me-2 text-secondary"></i>@T["Nav.AuditLog"]
                                </a>
                            </li>
                            }
                            @if (canSettings)
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Settings" asp-action="Index">
                                        <i class="bi bi-sliders me-2 text-primary"></i>@T["Nav.Settings"]
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                    }
                </ul>
                }
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2" asp-controller="Account" asp-action="Manage">
                                <i class="bi bi-person-circle me-1"></i>
                                    @(User.FindFirst("warecommand/display_name")?.Value ?? User.Identity.Name)
                            </a>
                        </li>
                        @if (canAccess)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2" asp-controller="Account" asp-action="Users">
                                    <i class="bi bi-people me-1"></i>@T["Nav.Accounts"]
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-link btn btn-link px-3 py-2">@T["Nav.SignOut"]</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>@T["Nav.SignIn"]
                            </a>
                        </li>
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated == true && accessibleWarehouses.Count > 0)
                {
                    <form asp-controller="Warehouses" asp-action="Select" method="post" class="d-flex align-items-center ms-lg-2 language-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@layoutReturnUrl" />
                        <label class="visually-hidden" for="layout-warehouse">@T["Warehouse.Select"]</label>
                        <select id="layout-warehouse" name="id" class="form-select form-select-sm" aria-label="@T["Warehouse.Select"]" onchange="this.form.submit()">
                            @foreach (var warehouse in accessibleWarehouses)
                            {
                                <option value="@warehouse.Id" selected="@(WarehouseContext.WarehouseId == warehouse.Id ? "selected" : null)">@warehouse.Code — @warehouse.Name</option>
                            }
                        </select>
                    </form>
                }
                <form asp-controller="Account" asp-action="SetLocale" method="post" class="d-flex align-items-center ms-lg-2 language-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReturnUrl" value="@languageReturnUrl" />
                    <label class="visually-hidden" for="layout-locale">@T["Language.Label"]</label>
                    <select id="layout-locale" name="Locale" class="form-select form-select-sm" aria-label="@T["Language.Switch"]" onchange="this.form.submit()">
                        @foreach (var locale in WmsLocaleCatalog.SupportedLocaleNames)
                        {
                            var languageKey = locale == WmsLocaleCatalog.Arabic ? "Language.Arabic" : "Language.English";
                            <option value="@locale" selected="@(string.Equals(locale, currentCulture.Name, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@T[languageKey]</option>
                        }
                    </select>
                </form>
            </div>
        </div>
    </nav>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="container wms-command-bar" data-wms-command-bar>
            <div class="wms-command-bar__identity">
                <span class="wms-command-bar__eyebrow">@T["Shell.OperatorTools"]</span>
                <span class="wms-command-bar__title">@T["Shell.CommandBar"]</span>
            </div>
            @if (canInventory)
            {
                <form asp-controller="Inventory" asp-action="Index" method="get" class="wms-quick-scan" data-wms-quick-scan role="search">
                    <label class="visually-hidden" for="wms-quick-scan-input">@T["Shell.QuickScan"]</label>
                    <i class="bi bi-upc-scan wms-quick-scan__icon" aria-hidden="true"></i>
                    <input id="wms-quick-scan-input" name="searchTerm" type="search"
                           class="wms-quick-scan__input" data-wms-scan-input
                           autocomplete="off" inputmode="search" enterkeyhint="search"
                           placeholder="@T["Shell.QuickScanPlaceholder"]"
                           aria-describedby="wms-quick-scan-hint" />
                    <span id="wms-quick-scan-hint" class="wms-quick-scan__hint">@T["Shell.ShortcutHint"]</span>
                    <button type="submit" class="btn btn-primary wms-touch-target" aria-label="@T["Common.Search"]">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <span class="d-none d-sm-inline ms-1">@T["Common.Search"]</span>
                    </button>
                </form>
            }
            <nav class="wms-command-links" aria-label="@T["Shell.OperatorTools"]">
                @if (canReceive)
                {
                    <a class="wms-command-link wms-touch-target" asp-controller="Receiving" asp-action="Receive">
                        <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i><span>@T["Nav.Receiving"]</span>
                    </a>
                }
                @if (canPick)
                {
                    <a class="wms-command-link wms-touch-target" asp-controller="Picking" asp-action="Index">
                        <i class="bi bi-box-arrow-up" aria-hidden="true"></i><span>@T["Nav.Picking"]</span>
                    </a>
                }
                @if (canInventory)
                {
                    <a class="wms-command-link wms-touch-target" asp-controller="Inventory" asp-action="Index">
                        <i class="bi bi-stack" aria-hidden="true"></i><span>@T["Nav.Inventory"]</span>
                    </a>
                }
            </nav>
        </div>
    }
</header>

<div class="container wms-connectivity-banner" data-wms-connectivity role="status" aria-live="polite" hidden>
    <i class="bi bi-wifi-off" data-wms-connectivity-icon aria-hidden="true"></i>
    <span data-wms-connectivity-text></span>
    <button type="button" class="btn btn-sm btn-outline-primary wms-touch-target" data-wms-connectivity-retry hidden>
        @T["Pwa.TryAgain"]
    </button>
    <button type="button" class="btn btn-sm btn-primary wms-touch-target ms-auto" data-wms-update hidden>
        @T["Pwa.Refresh"]
    </button>
</div>

<div class="container py-4 wms-page-frame">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-3 fs-4 text-success"></i>
                <div>
                    <strong>@T["Common.Success"]</strong>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Common.Close"]"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-4 text-danger"></i>
                <div>
                    <strong>@T["Common.Error"]</strong>
                    <div>@TempData["ErrorMessage"]</div>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Common.Close"]"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-info-circle-fill me-3 fs-4 text-info"></i>
                <div>
                    <strong>@T["Common.Information"]</strong>
                    <div>@TempData["InfoMessage"]</div>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Common.Close"]"></button>
        </div>
    }

    <main id="main-content" role="main" tabindex="-1" class="wms-main-content pb-3">
        @RenderBody()
    </main>
</div>

<footer class="bg-primary border-top py-4 mt-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="d-flex align-items-center text-white">
                    <i class="bi bi-boxes me-2"></i>
                    <span>&copy; 2025 - @T["App.Name"]</span>
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                <small class="footer-attribution">@T["App.Name"]</small>
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
