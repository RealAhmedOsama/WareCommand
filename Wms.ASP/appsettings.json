{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {},
  "Wms": {
    "DatabaseProvider": "PostgreSql",
    "SeedProfile": "None"
  },
  "Authentication": {
    "CookieName": "WareCommand.Auth",
    "CookieSecure": true,
    "CookieHours": 8,
    "RequireConfirmedEmail": false,
    "Password": {
      "RequiredLength": 12
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "Minutes": 15
    },
    "Bootstrap": {
      "Enabled": false
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "FromAddress": "",
      "EnableSsl": true
    }
  },
  "AllowedHosts": "*"
}
