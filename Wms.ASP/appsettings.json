{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "MaxRequestBodyBytes": 1048576,
    "MultipartBodyLengthLimitBytes": 10485760,
    "Hsts": {
      "MaxAgeDays": 180,
      "IncludeSubDomains": true,
      "Preload": false
    },
    "Antiforgery": {
      "SecureCookie": true,
      "CookieName": "__Host-WareCommand-Antiforgery"
    },
    "RateLimiting": {
      "GlobalPermitLimit": 600,
      "AuthenticationPermitLimit": 30,
      "PasswordResetPermitLimit": 10,
      "ReportPermitLimit": 60,
      "ApiPermitLimit": 120,
      "ScanningPermitLimit": 120,
      "ImportPermitLimit": 20,
      "WindowSeconds": 60,
      "PasswordResetWindowSeconds": 600
    }
  },
  "ConnectionStrings": {},
  "Wms": {
    "DatabaseProvider": "PostgreSql",
    "SeedProfile": "None",
    "Jobs": {
      "Enabled": false,
      "StorageSchema": "hangfire",
      "PrepareSchemaIfNecessary": true,
      "WorkerCount": 4,
      "MaximumRetryAttempts": 5,
      "RetryDelaysInSeconds": "30,120,600,1800,3600",
      "DashboardPath": "/jobs"
    },
    "Health": {
      "StoragePath": "",
      "MinimumFreeBytes": 268435456
    },
    "Telemetry": {
      "Enabled": true,
      "ServiceName": "WareCommand.Wms.Web",
      "ConsoleExporterEnabled": false,
      "SamplingRatio": 1.0,
      "Otlp": {
        "Enabled": false,
        "Endpoint": "",
        "Protocol": "grpc"
      }
    },
    "Logging": {
      "MinimumLevel": "Information",
      "ConsoleEnabled": true,
      "SlowOperationThresholdMilliseconds": 1000,
      "File": {
        "Enabled": false,
        "Path": "logs/warecommand-.json",
        "RetainedFileCountLimit": 14,
        "FileSizeLimitBytes": 52428800
      },
      "Overrides": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Authentication": {
    "CookieName": "WareCommand.Auth",
    "CookieSecure": true,
    "CookieHours": 8,
    "RequireConfirmedEmail": false,
    "Password": {
      "RequiredLength": 12
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "Minutes": 15
    },
    "Bootstrap": {
      "Enabled": false
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "FromAddress": "",
      "EnableSsl": true
    }
  },
  "AllowedHosts": "*"
}
