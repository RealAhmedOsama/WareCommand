{
  "AllowedHosts": "example.com",
  "ConnectionStrings": {},
  "Wms": {
    "DatabaseProvider": "PostgreSql",
    "SeedProfile": "None",
    "Attachments": {
      "Provider": "External",
      "RootPath": "/var/lib/warecommand/attachments",
      "MaximumFileSizeBytes": 10000000,
      "MaximumAttachmentsPerReference": 20,
      "MaximumRequestBodyBytes": 12000000,
      "RequireAntivirusScan": true
    },
    "Jobs": {
      "Enabled": false,
      "StorageSchema": "hangfire",
      "PrepareSchemaIfNecessary": true,
      "WorkerCount": 4,
      "MaximumRetryAttempts": 5,
      "RetryDelaysInSeconds": "30,120,600,1800,3600",
      "DashboardPath": "/jobs"
    },
    "Backups": {
      "Enabled": false,
      "RootPath": "/var/lib/warecommand/backups",
      "OffsitePath": "",
      "EncryptionKeyFile": "/run/secrets/warecommand-backup-key",
      "RetentionDays": 30,
      "MinimumRetainedBackups": 2,
      "MaximumAgeHours": 36,
      "AssetsPath": ""
    },
    "Health": {
      "StoragePath": "/var/lib/warecommand",
      "MinimumFreeBytes": 1073741824
    },
    "Telemetry": {
      "Enabled": true,
      "ServiceName": "WareCommand.Wms.Web",
      "ConsoleExporterEnabled": false,
      "SamplingRatio": 0.25,
      "Otlp": {
        "Enabled": false,
        "Endpoint": "",
        "Protocol": "grpc"
      }
    },
    "Logging": {
      "MinimumLevel": "Information",
      "ConsoleEnabled": true,
      "SlowOperationThresholdMilliseconds": 1000,
      "File": {
        "Enabled": false,
        "Path": "/var/lib/warecommand/logs/warecommand-.json",
        "RetainedFileCountLimit": 30,
        "FileSizeLimitBytes": 52428800
      },
      "Overrides": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "PostgresHost": "postgres",
    "PostgresPort": "5432",
    "PostgresDatabase": "warecommand",
    "PostgresUsername": "warecommand",
    "PostgresPasswordFile": "/run/secrets/warecommand-postgres-password"
  },
  "DataProtection": {
    "KeyDirectory": "/var/lib/warecommand/keys"
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": []
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Authentication": {
    "CookieSecure": true,
    "CookieHours": 8,
    "RequireConfirmedEmail": false,
    "Bootstrap": {
      "Enabled": false,
      "UserName": "",
      "Email": "",
      "DisplayName": "",
      "EmployeeCode": "",
      "PasswordFile": ""
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "EnableSsl": true
    }
  },
  "Security": {
    "MaxRequestBodyBytes": 1048576,
    "MultipartBodyLengthLimitBytes": 10485760,
    "Hsts": {
      "MaxAgeDays": 180,
      "IncludeSubDomains": true,
      "Preload": false
    },
    "Antiforgery": {
      "SecureCookie": true,
      "CookieName": "__Host-WareCommand-Antiforgery"
    },
    "RateLimiting": {
      "GlobalPermitLimit": 600,
      "AuthenticationPermitLimit": 30,
      "PasswordResetPermitLimit": 10,
      "ReportPermitLimit": 60,
      "ApiPermitLimit": 120,
      "ScanningPermitLimit": 120,
      "ImportPermitLimit": 20,
      "WindowSeconds": 60,
      "PasswordResetWindowSeconds": 600
    }
  },
  "Host": {
    "ShutdownTimeoutSeconds": 30
  }
}
