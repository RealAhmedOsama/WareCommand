{
  "AllowedHosts": "example.com",
  "ConnectionStrings": {},
  "Wms": {
    "DatabaseProvider": "PostgreSql",
    "SeedProfile": "None",
    "PostgresHost": "postgres",
    "PostgresPort": "5432",
    "PostgresDatabase": "warecommand",
    "PostgresUsername": "warecommand",
    "PostgresPasswordFile": "/run/secrets/warecommand-postgres-password"
  },
  "DataProtection": {
    "KeyDirectory": "/var/lib/warecommand/keys"
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": []
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Host": {
    "ShutdownTimeoutSeconds": 30
  }
}
