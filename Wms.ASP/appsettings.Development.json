{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=warehouse-development.db"
  },
  "Wms": {
    "DatabaseProvider": "Sqlite",
    "SeedProfile": "Demo",
    "Telemetry": {
      "ConsoleExporterEnabled": true,
      "Otlp": {
        "Enabled": false
      }
    },
    "Logging": {
      "ConsoleEnabled": true,
      "File": {
        "Enabled": false
      }
    }
  },
  "Security": {
    "Antiforgery": {
      "SecureCookie": false,
      "CookieName": "WareCommand-Antiforgery"
    }
  },
  "Authentication": {
    "CookieSecure": false,
    "Bootstrap": {
      "Enabled": false,
      "UserName": "local-admin",
      "Email": "local-admin@localhost",
      "DisplayName": "Local Administrator",
      "EmployeeCode": "LOCAL-ADMIN"
    }
  }
}
