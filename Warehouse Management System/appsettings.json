{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=wms.db"
  },
  "Wms": {
    "DatabaseProvider": "Sqlite",
    "SeedProfile": "Demo",
    "Logging": {
      "MinimumLevel": "Information",
      "ConsoleEnabled": false,
      "SlowOperationThresholdMilliseconds": 1000,
      "File": {
        "Enabled": true,
        "Path": "logs/warecommand-.json",
        "RetainedFileCountLimit": 14,
        "FileSizeLimitBytes": 52428800
      },
      "Overrides": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Warehouse": {
    "DefaultWarehouseCode": "MAIN",
    "ReceivingLocationCode": "RECEIVE",
    "ScannerTimeout": 5000,
    "EnableAudioFeedback": true
  },
  "WmsSettings": {
    "LowStockThreshold": 10,
    "AutoRefreshDashboard": true,
    "RefreshIntervalMinutes": 5,
    "DefaultReceiveLocation": "RECEIVE",
    "MaxBarcodeLength": 50,
    "MinBarcodeLength": 3,
    "EnableModernUI": true,
    "Theme": "Bootstrap5"
  }
}
